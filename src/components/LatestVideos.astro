---
import VideoCard from './VideoCard.astro';
import { getCollection } from 'astro:content';
import { isShort, formatDuration } from '../utils/youtube';

// Get all videos from YouTube loader
const allVideos = await getCollection('videos');

// Get all playlists from YouTube loader
const allPlaylists = await getCollection('playlists');

// Create playlist filter categories (with "All" as first option)
const playlistItems = allPlaylists
  .filter(playlist => playlist.data.itemCount > 0)
  .sort((a, b) => b.data.itemCount - a.data.itemCount)
  .map(playlist => ({
    id: playlist.id,
    label: playlist.data.title,
    videoIds: playlist.data.videoIds || [],
  }));

// Collect all video IDs that are in any playlist
const allPlaylistVideoIds = new Set(
  playlistItems.flatMap(playlist => playlist.videoIds)
);

const playlistFilters = [
  { id: 'all', label: 'All', videoIds: [] as string[] },
  ...playlistItems,
  { id: 'other', label: 'Other', videoIds: [] as string[] },
];

// Filter shorts and sort by published date (newest first)
const allNonShortVideos = allVideos
  .filter(video => !isShort(video.data.duration))
  .sort((a, b) => {
    const dateA = new Date(a.data.publishedAt);
    const dateB = new Date(b.data.publishedAt);
    return dateB.getTime() - dateA.getTime();
  });

// Skip the first video (shown in Hero) for the "More Videos" section
const sortedVideos = allNonShortVideos.slice(1);

// Find the most popular video (by view count)
const mostPopularVideo = sortedVideos.reduce((max, video) => {
  const maxViews = parseInt(max?.data?.viewCount || '0');
  const currentViews = parseInt(video.data.viewCount || '0');
  return currentViews > maxViews ? video : max;
}, sortedVideos[0]);

// Initially show 6 videos
const initialVideos = sortedVideos.slice(0, 6);
const hasVideos = initialVideos.length > 0;
const totalVideos = sortedVideos.length;

// Serialize video data for client-side use
const videosData = sortedVideos.map(video => ({
  id: video.id,
  title: video.data.title,
  thumbnail: video.data.thumbnails?.maxres?.url || video.data.thumbnails?.standard?.url || video.data.thumbnails?.high?.url || video.data.thumbnails?.medium?.url || '',
  duration: video.data.duration,
  viewCount: video.data.viewCount,
  likeCount: video.data.likeCount,
  publishedAt: video.data.publishedAt
}));
---

<section id="videos" class="py-24 px-6 lg:px-8 bg-brutal-white dark:bg-brutal-black">
  <div class="max-w-7xl mx-auto">
    <div class="mb-16">
      <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight mb-6">
        More Videos
      </h2>
      <p class="text-lg max-w-xl text-brutal-black/70 dark:text-brutal-white/70">
        Explore more content on AI orchestration and development workflows
      </p>
    </div>

    <!-- Playlist Filter Buttons -->
    <div class="flex flex-wrap gap-3 mb-12" id="filter-buttons" data-playlists={JSON.stringify(playlistFilters)} data-all-playlist-video-ids={JSON.stringify([...allPlaylistVideoIds])}>
      {playlistFilters.map((playlist, index) => (
        <button
          type="button"
          data-filter={playlist.id}
          data-video-ids={JSON.stringify(playlist.videoIds)}
          class={`px-5 py-3 text-xs font-bold uppercase tracking-widest border-2 transition-colors ${
            index === 0
              ? 'bg-brutal-black dark:bg-brutal-white text-brutal-white dark:text-brutal-black border-brutal-black dark:border-brutal-white'
              : 'bg-transparent text-brutal-black dark:text-brutal-white border-brutal-black dark:border-brutal-white hover:bg-brutal-black hover:text-brutal-white dark:hover:bg-brutal-white dark:hover:text-brutal-black'
          }`}
        >
          {playlist.label}
        </button>
      ))}
    </div>

    <!-- No Results Message (hidden by default) -->
    <div id="no-results" class="hidden py-16">
      <p class="text-lg font-semibold uppercase tracking-widest text-center">No videos found for this filter. Try a different category.</p>
    </div>

    {hasVideos ? (
      <div id="video-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {initialVideos.map((video) => (
          <div class="relative">
            {video.id === mostPopularVideo?.id && (
              <div class="absolute top-4 right-4 z-20 bg-brutal-accent text-brutal-white text-xs font-bold px-3 py-2 uppercase tracking-widest">
                Most Viewed
              </div>
            )}
            <VideoCard
              videoId={video.id}
              title={video.data.title}
              thumbnail={video.data.thumbnails?.maxres?.url || video.data.thumbnails?.standard?.url || video.data.thumbnails?.high?.url || video.data.thumbnails?.medium?.url || ''}
              duration={video.data.duration ? formatDuration(video.data.duration) : undefined}
              viewCount={video.data.viewCount ? parseInt(video.data.viewCount) : undefined}
              likeCount={video.data.likeCount ? parseInt(video.data.likeCount) : undefined}
              publishedAt={video.data.publishedAt}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="py-16">
        <p class="text-lg font-semibold uppercase tracking-widest text-center">Loading videos...</p>
      </div>
    )}

    <div class="mt-16">
      <button
        id="load-more-btn"
        data-videos={JSON.stringify(videosData)}
        data-most-popular={mostPopularVideo?.id}
        data-total={totalVideos}
        class="w-full md:w-auto inline-flex items-center gap-3 border-2 border-brutal-black dark:border-brutal-white px-8 py-5 text-sm font-bold uppercase tracking-widest hover:bg-brutal-black hover:text-brutal-white dark:hover:bg-brutal-white dark:hover:text-brutal-black transition-colors"
      >
        <span id="btn-text">View More Videos</span>
        <svg id="btn-icon-more" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
        <svg id="btn-icon-external" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const loadMoreBtn = document.getElementById('load-more-btn');
  const filterButtonsContainer = document.getElementById('filter-buttons');

  if (loadMoreBtn) {
    const allVideos = JSON.parse(loadMoreBtn.getAttribute('data-videos') || '[]');
    const mostPopularId = loadMoreBtn.getAttribute('data-most-popular');
    const totalVideos = parseInt(loadMoreBtn.getAttribute('data-total') || '0');
    const playlists = JSON.parse(filterButtonsContainer?.getAttribute('data-playlists') || '[]');
    const allPlaylistVideoIds = new Set(JSON.parse(filterButtonsContainer?.getAttribute('data-all-playlist-video-ids') || '[]'));

    let currentIndex = 6;
    const videosPerPage = 6;
    let currentFilter = 'all';
    let filteredVideos = [...allVideos];

    const videoGrid = document.getElementById('video-grid');
    const btnText = document.getElementById('btn-text');
    const btnIconMore = document.getElementById('btn-icon-more');
    const btnIconExternal = document.getElementById('btn-icon-external');
    const noResultsMessage = document.getElementById('no-results');

    const formatDuration = (duration) => {
      const match = duration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
      if (!match) return '';
      const hours = parseInt(match[1] || '0');
      const minutes = parseInt(match[2] || '0');
      const seconds = parseInt(match[3] || '0');
      if (hours > 0) {
        return `${hours}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      }
      return `${minutes}:${seconds.toString().padStart(2, '0')}`;
    };

    const formatViews = (count) => {
      if (!count) return "0 views";
      const num = parseInt(count);
      if (num < 1000) return `${num} views`;
      if (num < 1000000) return `${(num / 1000).toFixed(1)}K views`;
      return `${(num / 1000000).toFixed(1)}M views`;
    };

    const formatLikes = (count) => {
      if (!count) return "0 likes";
      const num = parseInt(count);
      const suffix = num === 1 ? " like" : " likes";
      if (num < 1000) return `${num}${suffix}`;
      if (num < 1000000) return `${(num / 1000).toFixed(1)}K${suffix}`;
      return `${(num / 1000000).toFixed(1)}M${suffix}`;
    };

    const getTimeAgo = (date) => {
      const now = new Date();
      const published = new Date(date);
      const diffMs = now.getTime() - published.getTime();
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      if (diffDays === 0) return "Today";
      if (diffDays === 1) return "Yesterday";
      if (diffDays < 7) return `${diffDays} days ago`;
      if (diffDays < 30) {
        const weeks = Math.floor(diffDays / 7);
        return weeks === 1 ? "1 week ago" : `${weeks} weeks ago`;
      }
      if (diffDays < 365) {
        const months = Math.floor(diffDays / 30);
        return months === 1 ? "1 month ago" : `${months} months ago`;
      }
      const years = Math.floor(diffDays / 365);
      return years === 1 ? "1 year ago" : `${years} years ago`;
    };

    const videoMatchesFilter = (video, filterId) => {
      if (filterId === 'all') return true;
      if (filterId === 'other') {
        return !allPlaylistVideoIds.has(video.id);
      }
      const playlist = playlists.find(p => p.id === filterId);
      if (!playlist || !playlist.videoIds || playlist.videoIds.length === 0) return false;
      return playlist.videoIds.includes(video.id);
    };

    const createVideoCard = (video) => {
      const duration = video.duration ? formatDuration(video.duration) : null;
      const views = formatViews(video.viewCount);
      const likes = formatLikes(video.likeCount);
      const timeAgo = getTimeAgo(video.publishedAt);
      const escapedTitle = video.title.replace(/'/g, "\\'").replace(/"/g, '&quot;');
      const isMostPopular = video.id === mostPopularId;

      return `
        <div class="relative video-card" data-video-id="${video.id}">
          ${isMostPopular ? `
          <div class="absolute top-4 right-4 z-20 bg-brutal-accent text-brutal-white text-xs font-bold px-3 py-2 uppercase tracking-widest">
            Most Viewed
          </div>
          ` : ''}
          <button
            type="button"
            onclick="openVideoModal('${video.id}', '${escapedTitle}')"
            class="group cursor-pointer block w-full text-left border-2 border-brutal-black dark:border-brutal-white hover:border-brutal-accent dark:hover:border-brutal-accent transition-colors"
          >
            <div class="relative aspect-video bg-brutal-black overflow-hidden">
              <img
                src="${video.thumbnail}"
                alt="${video.title}"
                class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
                loading="lazy"
              />
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="w-12 h-12 bg-brutal-accent flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="w-5 h-5 text-brutal-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              ${duration ? `
              <div class="absolute bottom-2 right-2 bg-brutal-black text-brutal-white text-xs font-bold px-2 py-1">
                ${duration}
              </div>` : ''}
            </div>
            <div class="p-5 bg-brutal-white dark:bg-brutal-black">
              <h3 class="font-bold text-brutal-black dark:text-brutal-white mb-3 line-clamp-2 group-hover:text-brutal-accent transition-colors text-sm uppercase tracking-wide">
                ${video.title}
              </h3>
              <div class="flex items-center text-xs font-semibold uppercase tracking-widest text-brutal-black/60 dark:text-brutal-white/60 gap-3">
                <div class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  ${views}
                </div>
                <span class="text-brutal-accent">&bull;</span>
                <div class="flex items-center gap-1">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                  </svg>
                  ${likes}
                </div>
                <span class="text-brutal-accent">&bull;</span>
                <span>${timeAgo}</span>
              </div>
            </div>
          </button>
        </div>
      `;
    };

    const renderFilteredVideos = () => {
      filteredVideos = allVideos.filter(video => videoMatchesFilter(video, currentFilter));
      videoGrid.innerHTML = '';
      currentIndex = 0;

      if (filteredVideos.length === 0) {
        noResultsMessage?.classList.remove('hidden');
        videoGrid.classList.add('hidden');
        loadMoreBtn.classList.add('hidden');
        return;
      }

      noResultsMessage?.classList.add('hidden');
      videoGrid.classList.remove('hidden');
      loadMoreBtn.classList.remove('hidden');

      const initialBatch = filteredVideos.slice(0, videosPerPage);
      initialBatch.forEach(video => {
        const videoCard = createVideoCard(video);
        videoGrid.insertAdjacentHTML('beforeend', videoCard);
      });

      currentIndex = videosPerPage;
      updateLoadMoreButton();
    };

    const updateLoadMoreButton = () => {
      if (currentIndex >= filteredVideos.length) {
        btnText.textContent = 'View All Videos';
        btnIconMore.classList.add('hidden');
        btnIconExternal.classList.remove('hidden');
        loadMoreBtn.onclick = () => {
          window.open('https://youtube.com/@BuildAtScale/videos', '_blank', 'noopener');
        };
      } else {
        btnText.textContent = 'View More Videos';
        btnIconMore.classList.remove('hidden');
        btnIconExternal.classList.add('hidden');
        loadMoreBtn.onclick = loadMoreVideos;
      }
    };

    const loadMoreVideos = () => {
      const nextVideos = filteredVideos.slice(currentIndex, currentIndex + videosPerPage);
      nextVideos.forEach(video => {
        const videoCard = createVideoCard(video);
        videoGrid.insertAdjacentHTML('beforeend', videoCard);
      });
      currentIndex += videosPerPage;
      updateLoadMoreButton();
    };

    const filterButtons = filterButtonsContainer?.querySelectorAll('button[data-filter]');
    filterButtons?.forEach(button => {
      button.addEventListener('click', () => {
        const filterId = button.getAttribute('data-filter');
        if (filterId === currentFilter) return;

        filterButtons.forEach(btn => {
          btn.classList.remove('bg-brutal-black', 'dark:bg-brutal-white', 'text-brutal-white', 'dark:text-brutal-black', 'border-brutal-black', 'dark:border-brutal-white');
          btn.classList.add('bg-transparent', 'text-brutal-black', 'dark:text-brutal-white', 'border-brutal-black', 'dark:border-brutal-white', 'hover:bg-brutal-black', 'hover:text-brutal-white', 'dark:hover:bg-brutal-white', 'dark:hover:text-brutal-black');
        });
        button.classList.remove('bg-transparent', 'text-brutal-black', 'dark:text-brutal-white', 'border-brutal-black', 'dark:border-brutal-white', 'hover:bg-brutal-black', 'hover:text-brutal-white', 'dark:hover:bg-brutal-white', 'dark:hover:text-brutal-black');
        button.classList.add('bg-brutal-black', 'dark:bg-brutal-white', 'text-brutal-white', 'dark:text-brutal-black', 'border-brutal-black', 'dark:border-brutal-white');

        currentFilter = filterId;
        renderFilteredVideos();
      });
    });

    if (currentIndex < totalVideos) {
      loadMoreBtn.onclick = loadMoreVideos;
    } else {
      btnText.textContent = 'View All Videos';
      btnIconMore.classList.add('hidden');
      btnIconExternal.classList.remove('hidden');
      loadMoreBtn.onclick = () => {
        window.open('https://youtube.com/@buildatscale', '_blank', 'noopener');
      };
    }
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
