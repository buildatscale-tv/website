---
import VideoCard from './VideoCard.astro';
import { getCollection } from 'astro:content';
import { isShort, formatDuration } from '../utils/youtube';

// Get all videos from YouTube loader
const allVideos = await getCollection('videos');

// Get all playlists from YouTube loader
const allPlaylists = await getCollection('playlists');

// Create playlist filter categories (with "All" as first option)
const playlistItems = allPlaylists
  .filter(playlist => playlist.data.itemCount > 0) // Only show playlists with videos
  .sort((a, b) => b.data.itemCount - a.data.itemCount) // Sort by video count
  .map(playlist => ({
    id: playlist.id,
    label: playlist.data.title,
    videoIds: playlist.data.videoIds || [],
  }));

// Collect all video IDs that are in any playlist
const allPlaylistVideoIds = new Set(
  playlistItems.flatMap(playlist => playlist.videoIds)
);

const playlistFilters = [
  { id: 'all', label: 'All', videoIds: [] as string[] },
  ...playlistItems,
  { id: 'other', label: 'Other', videoIds: [] as string[] },
];

// Filter shorts and sort by published date (newest first)
const allNonShortVideos = allVideos
  .filter(video => !isShort(video.data.duration))
  .sort((a, b) => {
    const dateA = new Date(a.data.publishedAt);
    const dateB = new Date(b.data.publishedAt);
    return dateB.getTime() - dateA.getTime();
  });

// Skip the first video (shown in Hero) for the "More Videos" section
const sortedVideos = allNonShortVideos.slice(1);

// Find the most popular video (by view count)
const mostPopularVideo = sortedVideos.reduce((max, video) => {
  const maxViews = parseInt(max?.data?.viewCount || '0');
  const currentViews = parseInt(video.data.viewCount || '0');
  return currentViews > maxViews ? video : max;
}, sortedVideos[0]);

// Initially show 6 videos
const initialVideos = sortedVideos.slice(0, 6);
const hasVideos = initialVideos.length > 0;
const totalVideos = sortedVideos.length;

// Serialize video data for client-side use (include title for filtering)
const videosData = sortedVideos.map(video => ({
  id: video.id,
  title: video.data.title,
  thumbnail: video.data.thumbnails?.maxres?.url || video.data.thumbnails?.standard?.url || video.data.thumbnails?.high?.url || video.data.thumbnails?.medium?.url || '',
  duration: video.data.duration,
  viewCount: video.data.viewCount,
  likeCount: video.data.likeCount,
  publishedAt: video.data.publishedAt
}));
---

<section id="videos" class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-surface-0"></div>
  <div class="absolute inset-0 grid-pattern opacity-20"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        More <span class="gradient-text">Videos</span>
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Explore content on AI orchestration, parallel coding agents, and modern development workflows
      </p>
    </div>

    <!-- Playlist Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-2 mb-12" id="filter-buttons" data-playlists={JSON.stringify(playlistFilters)} data-all-playlist-video-ids={JSON.stringify([...allPlaylistVideoIds])}>
      {playlistFilters.map((playlist, index) => (
        <button
          type="button"
          data-filter={playlist.id}
          data-video-ids={JSON.stringify(playlist.videoIds)}
          class={`px-4 py-2 rounded-lg text-sm font-medium transition-all duration-300 ${
            index === 0
              ? 'bg-gradient-to-r from-accent-blue to-accent-cyan text-white shadow-lg shadow-accent-blue/25'
              : 'bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 border border-white/5 hover:border-white/10'
          }`}
        >
          {playlist.label}
        </button>
      ))}
    </div>

    <!-- No Results Message -->
    <div id="no-results" class="hidden text-center py-16">
      <p class="text-gray-400">No videos found for this filter. Try a different category.</p>
    </div>

    {hasVideos ? (
      <div id="video-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {initialVideos.map((video) => (
          <div class="relative reveal-on-scroll">
            {video.id === mostPopularVideo?.id && (
              <div class="absolute top-4 right-4 z-20 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-lg">
                Most Viewed
              </div>
            )}
            <VideoCard
              videoId={video.id}
              title={video.data.title}
              thumbnail={video.data.thumbnails?.maxres?.url || video.data.thumbnails?.standard?.url || video.data.thumbnails?.high?.url || video.data.thumbnails?.medium?.url || ''}
              duration={video.data.duration ? formatDuration(video.data.duration) : undefined}
              viewCount={video.data.viewCount ? parseInt(video.data.viewCount) : undefined}
              likeCount={video.data.likeCount ? parseInt(video.data.likeCount) : undefined}
              publishedAt={video.data.publishedAt}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-gray-400">Loading videos...</p>
      </div>
    )}

    <div class="text-center mt-16">
      <button
        id="load-more-btn"
        data-videos={JSON.stringify(videosData)}
        data-most-popular={mostPopularVideo?.id}
        data-total={totalVideos}
        class="group px-8 py-4 bg-white/5 hover:bg-white/10 text-gray-300 hover:text-white font-medium rounded-xl border border-white/10 hover:border-white/20 transition-all duration-300"
      >
        <span id="btn-text" class="flex items-center space-x-2">
          <span>View More Videos</span>
          <svg id="btn-icon-more" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
          <svg id="btn-icon-external" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</section>

<script>
  // Get data from button attributes
  const loadMoreBtn = document.getElementById('load-more-btn');
  const filterButtonsContainer = document.getElementById('filter-buttons');

  if (loadMoreBtn) {
    const allVideos = JSON.parse(loadMoreBtn.getAttribute('data-videos') || '[]');
    const mostPopularId = loadMoreBtn.getAttribute('data-most-popular');
    const totalVideos = parseInt(loadMoreBtn.getAttribute('data-total') || '0');
    const playlists = JSON.parse(filterButtonsContainer?.getAttribute('data-playlists') || '[]');
    const allPlaylistVideoIds = new Set(JSON.parse(filterButtonsContainer?.getAttribute('data-all-playlist-video-ids') || '[]'));

    let currentIndex = 6;
    const videosPerPage = 6;
    let currentFilter = 'all';
    let filteredVideos = [...allVideos];

    const videoGrid = document.getElementById('video-grid');
    const btnText = document.getElementById('btn-text');
    const btnIconMore = document.getElementById('btn-icon-more');
    const btnIconExternal = document.getElementById('btn-icon-external');
    const noResultsMessage = document.getElementById('no-results');

    // Helper function to format duration from ISO 8601
    const formatDuration = (duration) => {
      const match = duration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
      if (!match) return '';

      const hours = parseInt(match[1] || '0');
      const minutes = parseInt(match[2] || '0');
      const seconds = parseInt(match[3] || '0');

      if (hours > 0) {
        return `${hours}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      }
      return `${minutes}:${seconds.toString().padStart(2, '0')}`;
    };

    // Helper function to format view count
    const formatViews = (count) => {
      if (!count) return "0 views";
      const num = parseInt(count);
      if (num < 1000) return `${num} views`;
      if (num < 1000000) return `${(num / 1000).toFixed(1)}K views`;
      return `${(num / 1000000).toFixed(1)}M views`;
    };

    // Helper function to format like count
    const formatLikes = (count) => {
      if (!count) return "0 likes";
      const num = parseInt(count);
      const suffix = num === 1 ? " like" : " likes";
      if (num < 1000) return `${num}${suffix}`;
      if (num < 1000000) return `${(num / 1000).toFixed(1)}K${suffix}`;
      return `${(num / 1000000).toFixed(1)}M${suffix}`;
    };

    // Helper function to format time ago
    const getTimeAgo = (date) => {
      const now = new Date();
      const published = new Date(date);
      const diffMs = now.getTime() - published.getTime();
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));

      if (diffDays === 0) return "Today";
      if (diffDays === 1) return "Yesterday";
      if (diffDays < 7) return `${diffDays} days ago`;
      if (diffDays < 30) {
        const weeks = Math.floor(diffDays / 7);
        return weeks === 1 ? "1 week ago" : `${weeks} weeks ago`;
      }
      if (diffDays < 365) {
        const months = Math.floor(diffDays / 30);
        return months === 1 ? "1 month ago" : `${months} months ago`;
      }
      const years = Math.floor(diffDays / 365);
      return years === 1 ? "1 year ago" : `${years} years ago`;
    };

    // Function to check if video matches filter (by playlist membership)
    const videoMatchesFilter = (video, filterId) => {
      if (filterId === 'all') return true;

      // "Other" shows videos not in any playlist
      if (filterId === 'other') {
        return !allPlaylistVideoIds.has(video.id);
      }

      const playlist = playlists.find(p => p.id === filterId);
      if (!playlist || !playlist.videoIds || playlist.videoIds.length === 0) return false;

      return playlist.videoIds.includes(video.id);
    };

    // Function to create video card HTML
    const createVideoCard = (video) => {
      const duration = video.duration ? formatDuration(video.duration) : null;
      const views = formatViews(video.viewCount);
      const likes = formatLikes(video.likeCount);
      const timeAgo = getTimeAgo(video.publishedAt);
      const escapedTitle = video.title.replace(/'/g, "\\'").replace(/"/g, '&quot;');
      const isMostPopular = video.id === mostPopularId;

      return `
        <div class="relative video-card" data-video-id="${video.id}">
          ${isMostPopular ? `
          <div class="absolute top-4 right-4 z-20 bg-gradient-to-r from-amber-500 to-orange-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-lg">
            Most Viewed
          </div>
          ` : ''}
          <button
            type="button"
            onclick="openVideoModal('${video.id}', '${escapedTitle}')"
            class="group bg-surface-2 rounded-xl overflow-hidden border border-white/5 hover:border-white/10 transition-all duration-300 hover:shadow-xl hover:shadow-black/20 cursor-pointer block w-full text-left"
          >
            <div class="relative aspect-video bg-surface-3">
              <img
                src="${video.thumbnail}"
                alt="${video.title}"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 flex items-center justify-center transition-all duration-500">
                <div class="w-14 h-14 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-500 border border-white/30">
                  <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              ${duration ? `
              <div class="absolute bottom-3 right-3 bg-black/80 backdrop-blur-sm text-white text-xs px-2.5 py-1 rounded-lg font-mono">
                ${duration}
              </div>` : ''}
            </div>
            <div class="p-5">
              <h3 class="font-semibold text-white mb-3 line-clamp-2 group-hover:text-accent-blue transition-colors text-sm leading-relaxed min-h-[2.5rem]">
                ${video.title}
              </h3>
              <div class="flex items-center text-xs text-gray-500 space-x-3">
                <div class="flex items-center">
                  <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  ${views}
                </div>
                <span class="text-gray-600">•</span>
                <div class="flex items-center">
                  <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
                  </svg>
                  ${likes}
                </div>
                <span class="text-gray-600">•</span>
                <span>${timeAgo}</span>
              </div>
            </div>
          </button>
        </div>
      `;
    };

    // Function to render videos based on current filter
    const renderFilteredVideos = () => {
      // Filter videos based on current filter
      filteredVideos = allVideos.filter(video => videoMatchesFilter(video, currentFilter));

      // Clear the grid
      videoGrid.innerHTML = '';

      // Reset index
      currentIndex = 0;

      // Show no results message if needed
      if (filteredVideos.length === 0) {
        noResultsMessage?.classList.remove('hidden');
        videoGrid.classList.add('hidden');
        loadMoreBtn.classList.add('hidden');
        return;
      }

      noResultsMessage?.classList.add('hidden');
      videoGrid.classList.remove('hidden');
      loadMoreBtn.classList.remove('hidden');

      // Show first batch of filtered videos
      const initialBatch = filteredVideos.slice(0, videosPerPage);
      initialBatch.forEach(video => {
        const videoCard = createVideoCard(video);
        videoGrid.insertAdjacentHTML('beforeend', videoCard);
      });

      currentIndex = videosPerPage;
      updateLoadMoreButton();
    };

    // Function to update load more button state
    const updateLoadMoreButton = () => {
      if (currentIndex >= filteredVideos.length) {
        btnText.innerHTML = `
          <span>View All on YouTube</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        `;
        loadMoreBtn.onclick = () => {
          window.open('https://youtube.com/@BuildAtScale/videos', '_blank', 'noopener');
        };
      } else {
        btnText.innerHTML = `
          <span>View More Videos</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        `;
        loadMoreBtn.onclick = loadMoreVideos;
      }
    };

    // Load more videos function
    const loadMoreVideos = () => {
      const nextVideos = filteredVideos.slice(currentIndex, currentIndex + videosPerPage);

      nextVideos.forEach(video => {
        const videoCard = createVideoCard(video);
        videoGrid.insertAdjacentHTML('beforeend', videoCard);
      });

      currentIndex += videosPerPage;
      updateLoadMoreButton();
    };

    // Set up filter button click handlers
    const filterButtons = filterButtonsContainer?.querySelectorAll('button[data-filter]');
    filterButtons?.forEach(button => {
      button.addEventListener('click', () => {
        const filterId = button.getAttribute('data-filter');
        if (filterId === currentFilter) return;

        // Update active state
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-gradient-to-r', 'from-accent-blue', 'to-accent-cyan', 'text-white', 'shadow-lg', 'shadow-accent-blue/25');
          btn.classList.add('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/5', 'hover:border-white/10');
        });
        button.classList.remove('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/5', 'hover:border-white/10');
        button.classList.add('bg-gradient-to-r', 'from-accent-blue', 'to-accent-cyan', 'text-white', 'shadow-lg', 'shadow-accent-blue/25');

        currentFilter = filterId;
        renderFilteredVideos();
      });
    });

    // Initial button click handler
    if (currentIndex < totalVideos) {
      loadMoreBtn.onclick = loadMoreVideos;
    } else {
      // All videos already shown, make it external link
      btnText.innerHTML = `
        <span>View All on YouTube</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      `;
      loadMoreBtn.onclick = () => {
        window.open('https://youtube.com/@buildatscale', '_blank', 'noopener');
      };
    }
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
