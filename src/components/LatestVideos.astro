---
import VideoCard from './VideoCard.astro';
import { getCollection } from 'astro:content';
import { isShort, formatDuration } from '../utils/youtube';

const allVideos = await getCollection('videos');
const allPlaylists = await getCollection('playlists');

const playlistItems = allPlaylists
  .filter(playlist => playlist.data.itemCount > 0)
  .sort((a, b) => b.data.itemCount - a.data.itemCount)
  .map(playlist => ({
    id: playlist.id,
    label: playlist.data.title,
    videoIds: playlist.data.videoIds || [],
  }));

const allPlaylistVideoIds = new Set(
  playlistItems.flatMap(playlist => playlist.videoIds)
);

const playlistFilters = [
  { id: 'all', label: 'All', videoIds: [] as string[] },
  ...playlistItems,
  { id: 'other', label: 'Other', videoIds: [] as string[] },
];

const allNonShortVideos = allVideos
  .filter(video => !isShort(video.data.duration))
  .sort((a, b) => {
    const dateA = new Date(a.data.publishedAt);
    const dateB = new Date(b.data.publishedAt);
    return dateB.getTime() - dateA.getTime();
  });

const sortedVideos = allNonShortVideos.slice(1);

const mostPopularVideo = sortedVideos.reduce((max, video) => {
  const maxViews = parseInt(max?.data?.viewCount || '0');
  const currentViews = parseInt(video.data.viewCount || '0');
  return currentViews > maxViews ? video : max;
}, sortedVideos[0]);

const initialVideos = sortedVideos.slice(0, 6);
const hasVideos = initialVideos.length > 0;
const totalVideos = sortedVideos.length;

const videosData = sortedVideos.map(video => ({
  id: video.id,
  title: video.data.title,
  thumbnail: video.data.thumbnails?.maxres?.url || video.data.thumbnails?.standard?.url || video.data.thumbnails?.high?.url || video.data.thumbnails?.medium?.url || '',
  duration: video.data.duration,
  viewCount: video.data.viewCount,
  likeCount: video.data.likeCount,
  publishedAt: video.data.publishedAt
}));
---

<section id="videos" class="relative py-20 px-4 sm:px-6 lg:px-8 section-transition">
  <!-- Background glow -->
  <div class="absolute inset-0 bg-gradient-radial from-neon-cyan/5 via-transparent to-transparent opacity-50"></div>

  <div class="relative z-10 max-w-7xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="pill-badge">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Video Library
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Explore More <span class="gradient-text">Content</span>
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Deep dives into AI orchestration, development workflows, and infrastructure automation
      </p>
    </div>

    <!-- Filter buttons -->
    <div class="flex flex-wrap justify-center gap-2 mb-10 reveal" id="filter-buttons" data-playlists={JSON.stringify(playlistFilters)} data-all-playlist-video-ids={JSON.stringify([...allPlaylistVideoIds])}>
      {playlistFilters.map((playlist, index) => (
        <button
          type="button"
          data-filter={playlist.id}
          data-video-ids={JSON.stringify(playlist.videoIds)}
          class={`px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 ${
            index === 0
              ? 'bg-gradient-to-r from-neon-cyan to-neon-blue text-surface shadow-lg shadow-neon-cyan/20'
              : 'bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 border border-white/10 hover:border-neon-cyan/30'
          }`}
        >
          {playlist.label}
        </button>
      ))}
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-16">
      <div class="text-6xl mb-4">🔍</div>
      <p class="text-gray-400 text-lg">No videos found for this filter. Try a different category.</p>
    </div>

    {hasVideos ? (
      <div id="video-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 stagger-children">
        {initialVideos.map((video) => (
          <div class="relative">
            {video.id === mostPopularVideo?.id && (
              <div class="absolute -top-2 -right-2 z-20 bg-gradient-to-r from-neon-cyan to-neon-blue text-surface text-xs font-bold px-3 py-1.5 rounded-full shadow-lg shadow-neon-cyan/30 transform rotate-3">
                ⭐ Most Viewed
              </div>
            )}
            <VideoCard
              videoId={video.id}
              title={video.data.title}
              thumbnail={video.data.thumbnails?.maxres?.url || video.data.thumbnails?.standard?.url || video.data.thumbnails?.high?.url || video.data.thumbnails?.medium?.url || ''}
              duration={video.data.duration ? formatDuration(video.data.duration) : undefined}
              viewCount={video.data.viewCount ? parseInt(video.data.viewCount) : undefined}
              likeCount={video.data.likeCount ? parseInt(video.data.likeCount) : undefined}
              publishedAt={video.data.publishedAt}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <div class="inline-block w-12 h-12 border-2 border-neon-cyan/30 border-t-neon-cyan rounded-full animate-spin mb-4"></div>
        <p class="text-gray-400">Loading videos...</p>
      </div>
    )}

    <!-- Load more button -->
    <div class="text-center mt-12 reveal">
      <button
        id="load-more-btn"
        data-videos={JSON.stringify(videosData)}
        data-most-popular={mostPopularVideo?.id}
        data-total={totalVideos}
        class="group inline-flex items-center gap-2 px-8 py-4 rounded-xl font-medium border border-white/10 hover:border-neon-cyan/50 text-white hover:text-neon-cyan transition-all duration-300 hover:bg-white/5"
      >
        <span id="btn-text">View More Videos</span>
        <svg id="btn-icon-more" class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
        <svg id="btn-icon-external" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const loadMoreBtn = document.getElementById('load-more-btn');
  const filterButtonsContainer = document.getElementById('filter-buttons');

  if (loadMoreBtn) {
    const allVideos = JSON.parse(loadMoreBtn.getAttribute('data-videos') || '[]');
    const mostPopularId = loadMoreBtn.getAttribute('data-most-popular');
    const totalVideos = parseInt(loadMoreBtn.getAttribute('data-total') || '0');
    const playlists = JSON.parse(filterButtonsContainer?.getAttribute('data-playlists') || '[]');
    const allPlaylistVideoIds = new Set(JSON.parse(filterButtonsContainer?.getAttribute('data-all-playlist-video-ids') || '[]'));

    let currentIndex = 6;
    const videosPerPage = 6;
    let currentFilter = 'all';
    let filteredVideos = [...allVideos];

    const videoGrid = document.getElementById('video-grid');
    const btnText = document.getElementById('btn-text');
    const btnIconMore = document.getElementById('btn-icon-more');
    const btnIconExternal = document.getElementById('btn-icon-external');
    const noResultsMessage = document.getElementById('no-results');

    const formatDuration = (duration) => {
      const match = duration.match(/PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?/);
      if (!match) return '';
      const hours = parseInt(match[1] || '0');
      const minutes = parseInt(match[2] || '0');
      const seconds = parseInt(match[3] || '0');
      if (hours > 0) {
        return `${hours}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      }
      return `${minutes}:${seconds.toString().padStart(2, '0')}`;
    };

    const formatViews = (count) => {
      if (!count) return "0 views";
      const num = parseInt(count);
      if (num < 1000) return `${num} views`;
      if (num < 1000000) return `${(num / 1000).toFixed(1)}K views`;
      return `${(num / 1000000).toFixed(1)}M views`;
    };

    const formatLikes = (count) => {
      if (!count) return "0 likes";
      const num = parseInt(count);
      const suffix = num === 1 ? " like" : " likes";
      if (num < 1000) return `${num}${suffix}`;
      if (num < 1000000) return `${(num / 1000).toFixed(1)}K${suffix}`;
      return `${(num / 1000000).toFixed(1)}M${suffix}`;
    };

    const getTimeAgo = (date) => {
      const now = new Date();
      const published = new Date(date);
      const diffMs = now.getTime() - published.getTime();
      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      if (diffDays === 0) return "Today";
      if (diffDays === 1) return "Yesterday";
      if (diffDays < 7) return `${diffDays} days ago`;
      if (diffDays < 30) {
        const weeks = Math.floor(diffDays / 7);
        return weeks === 1 ? "1 week ago" : `${weeks} weeks ago`;
      }
      if (diffDays < 365) {
        const months = Math.floor(diffDays / 30);
        return months === 1 ? "1 month ago" : `${months} months ago`;
      }
      const years = Math.floor(diffDays / 365);
      return years === 1 ? "1 year ago" : `${years} years ago`;
    };

    const videoMatchesFilter = (video, filterId) => {
      if (filterId === 'all') return true;
      if (filterId === 'other') {
        return !allPlaylistVideoIds.has(video.id);
      }
      const playlist = playlists.find(p => p.id === filterId);
      if (!playlist || !playlist.videoIds || playlist.videoIds.length === 0) return false;
      return playlist.videoIds.includes(video.id);
    };

    const createVideoCard = (video) => {
      const duration = video.duration ? formatDuration(video.duration) : null;
      const views = formatViews(video.viewCount);
      const likes = formatLikes(video.likeCount);
      const timeAgo = getTimeAgo(video.publishedAt);
      const escapedTitle = video.title.replace(/'/g, "\\'").replace(/"/g, '&quot;');
      const isMostPopular = video.id === mostPopularId;

      return `
        <div class="relative video-card" data-video-id="${video.id}">
          ${isMostPopular ? `
          <div class="absolute -top-2 -right-2 z-20 bg-gradient-to-r from-neon-cyan to-neon-blue text-surface text-xs font-bold px-3 py-1.5 rounded-full shadow-lg shadow-neon-cyan/30 transform rotate-3">
            ⭐ Most Viewed
          </div>
          ` : ''}
          <button
            type="button"
            onclick="openVideoModal('${video.id}', '${escapedTitle}')"
            class="card-hover group relative w-full text-left glass-card rounded-xl overflow-hidden"
          >
            <div class="relative aspect-video bg-surface-lighter overflow-hidden">
              <img
                src="${video.thumbnail}"
                alt="${video.title}"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300">
                <div class="w-14 h-14 rounded-full bg-neon-pink/90 backdrop-blur-sm flex items-center justify-center transform scale-75 group-hover:scale-100 transition-transform duration-300">
                  <svg class="w-6 h-6 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </div>
              </div>
              ${duration ? `
              <div class="absolute bottom-3 right-3 bg-surface/90 backdrop-blur-sm text-white px-2.5 py-1 rounded-md font-mono text-xs border border-white/10">
                ${duration}
              </div>` : ''}
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-white mb-3 line-clamp-2 group-hover:text-neon-cyan transition-colors text-sm leading-snug">
                ${video.title}
              </h3>
              <div class="flex items-center text-xs text-gray-500 gap-3 flex-nowrap">
                <div class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-neon-cyan/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                  </svg>
                  ${views}
                </div>
                <span class="text-gray-600">•</span>
                <div class="flex items-center gap-1.5">
                  <svg class="w-3.5 h-3.5 text-neon-purple/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                  ${likes}
                </div>
                <span class="text-gray-600">•</span>
                <span class="text-gray-500">${timeAgo}</span>
              </div>
            </div>
          </button>
        </div>
      `;
    };

    const renderFilteredVideos = () => {
      filteredVideos = allVideos.filter(video => videoMatchesFilter(video, currentFilter));
      videoGrid.innerHTML = '';
      currentIndex = 0;

      if (filteredVideos.length === 0) {
        noResultsMessage?.classList.remove('hidden');
        videoGrid.classList.add('hidden');
        loadMoreBtn.classList.add('hidden');
        return;
      }

      noResultsMessage?.classList.add('hidden');
      videoGrid.classList.remove('hidden');
      loadMoreBtn.classList.remove('hidden');

      const initialBatch = filteredVideos.slice(0, videosPerPage);
      initialBatch.forEach(video => {
        const videoCard = createVideoCard(video);
        videoGrid.insertAdjacentHTML('beforeend', videoCard);
      });

      currentIndex = videosPerPage;
      updateLoadMoreButton();
    };

    const updateLoadMoreButton = () => {
      if (currentIndex >= filteredVideos.length) {
        btnText.textContent = 'View All Videos';
        btnIconMore.classList.add('hidden');
        btnIconExternal.classList.remove('hidden');
        loadMoreBtn.onclick = () => {
          window.open('https://youtube.com/@BuildAtScale/videos', '_blank', 'noopener');
        };
      } else {
        btnText.textContent = 'View More Videos';
        btnIconMore.classList.remove('hidden');
        btnIconExternal.classList.add('hidden');
        loadMoreBtn.onclick = loadMoreVideos;
      }
    };

    const loadMoreVideos = () => {
      const nextVideos = filteredVideos.slice(currentIndex, currentIndex + videosPerPage);
      nextVideos.forEach(video => {
        const videoCard = createVideoCard(video);
        videoGrid.insertAdjacentHTML('beforeend', videoCard);
      });
      currentIndex += videosPerPage;
      updateLoadMoreButton();
    };

    const filterButtons = filterButtonsContainer?.querySelectorAll('button[data-filter]');
    filterButtons?.forEach(button => {
      button.addEventListener('click', () => {
        const filterId = button.getAttribute('data-filter');
        if (filterId === currentFilter) return;

        filterButtons.forEach(btn => {
          btn.classList.remove('bg-gradient-to-r', 'from-neon-cyan', 'to-neon-blue', 'text-surface', 'shadow-lg', 'shadow-neon-cyan/20');
          btn.classList.add('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/10', 'hover:border-neon-cyan/30');
        });
        button.classList.remove('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/10', 'hover:border-neon-cyan/30');
        button.classList.add('bg-gradient-to-r', 'from-neon-cyan', 'to-neon-blue', 'text-surface', 'shadow-lg', 'shadow-neon-cyan/20');

        currentFilter = filterId;
        renderFilteredVideos();
      });
    });

    if (currentIndex < totalVideos) {
      loadMoreBtn.onclick = loadMoreVideos;
    } else {
      btnText.textContent = 'View All Videos';
      btnIconMore.classList.add('hidden');
      btnIconExternal.classList.remove('hidden');
      loadMoreBtn.onclick = () => {
        window.open('https://youtube.com/@buildatscale', '_blank', 'noopener');
      };
    }
  }
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
