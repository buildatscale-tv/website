---
const interests = [
  'AI Orchestration',
  'Claude Code',
  'Web Development',
  'DevOps & Infrastructure',
  'Python Automation',
  'JavaScript / TypeScript'
];
---

<section class="relative py-20 px-4 sm:px-6 lg:px-8 section-transition">
  <!-- Background glow -->
  <div class="absolute inset-0 bg-gradient-radial from-neon-purple/5 via-transparent to-transparent opacity-50"></div>

  <div class="relative z-10 max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="pill-badge" style="border-color: rgba(184, 41, 221, 0.3); color: #b829dd; background: rgba(184, 41, 221, 0.1);">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          Newsletter
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Stay <span class="gradient-text">Updated</span>
      </h2>
      <p class="text-lg text-gray-400 max-w-xl mx-auto">
        Get notified when I publish new content about AI orchestration, development workflows,
        and the latest experiments. No spam, just valuable insights.
      </p>
    </div>

    <div class="glass-card rounded-2xl p-8 reveal">
      <form id="newsletter-form" class="space-y-6">
        <div>
          <label for="signup-email" class="block text-sm font-medium text-gray-400 mb-2">
            Email Address
          </label>
          <input
            type="email"
            id="signup-email"
            name="email"
            class="input-glow w-full px-4 py-3 rounded-xl text-white placeholder-gray-500"
            placeholder="your@email.com"
            required
          />
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-400 mb-3">
            What interests you most? (Optional)
          </label>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            {interests.map((interest) => (
              <button
                type="button"
                data-interest={interest}
                class="interest-btn px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 bg-white/5 text-gray-400 hover:text-white hover:bg-white/10 border border-white/10 hover:border-neon-cyan/30 text-center"
              >
                {interest}
              </button>
            ))}
          </div>
        </div>

        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between">
            <button
              type="submit"
              id="newsletter-submit"
              class="btn-neon bg-gradient-to-r from-neon-purple to-neon-pink text-white px-8 py-3 rounded-xl font-semibold transition-all duration-300"
            >
              <span id="newsletter-submit-text">Subscribe</span>
              <div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin hidden inline-block ml-2" id="newsletter-spinner"></div>
            </button>

            <div id="newsletter-success" class="text-neon-green font-medium flex items-center gap-2 hidden">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span id="newsletter-success-text">Successfully subscribed!</span>
            </div>
          </div>

          <div id="newsletter-error" class="text-neon-pink font-medium text-sm hidden"></div>

          <p class="text-xs text-gray-500">
            No spam, ever. Unsubscribe at any time. I respect your privacy and will only send valuable content updates.
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form');
  const submitBtn = document.getElementById('newsletter-submit');
  const submitText = document.getElementById('newsletter-submit-text');
  const spinner = document.getElementById('newsletter-spinner');
  const successMsg = document.getElementById('newsletter-success');
  const successText = document.getElementById('newsletter-success-text');
  const errorMsg = document.getElementById('newsletter-error');
  const interestBtns = document.querySelectorAll('.interest-btn');
  const selectedInterests = new Set<string>();

  interestBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const interest = btn.getAttribute('data-interest');
      if (interest) {
        if (selectedInterests.has(interest)) {
          selectedInterests.delete(interest);
          btn.classList.remove('bg-gradient-to-r', 'from-neon-purple', 'to-neon-pink', 'text-white', 'border-neon-purple/50');
          btn.classList.add('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/10', 'hover:border-neon-cyan/30');
        } else {
          selectedInterests.add(interest);
          btn.classList.remove('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/10', 'hover:border-neon-cyan/30');
          btn.classList.add('bg-gradient-to-r', 'from-neon-purple', 'to-neon-pink', 'text-white', 'border-neon-purple/50');
        }
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn?.setAttribute('disabled', 'true');
    submitBtn?.classList.add('opacity-50', 'cursor-not-allowed');
    submitText!.textContent = 'Subscribing...';
    spinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const formData = new FormData(e.target as HTMLFormElement);
      formData.append('interests', JSON.stringify(Array.from(selectedInterests)));

      const response = await fetch('/api/newsletter-signup', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to subscribe');
      }

      submitBtn?.removeAttribute('disabled');
      submitBtn?.classList.remove('opacity-50', 'cursor-not-allowed');
      submitText!.textContent = 'Subscribe';
      spinner?.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      if (result.message) {
        successText!.textContent = result.message;
      } else {
        successText!.textContent = 'Successfully subscribed!';
      }

      (e.target as HTMLFormElement).reset();

      selectedInterests.clear();
      interestBtns.forEach(btn => {
        btn.classList.remove('bg-gradient-to-r', 'from-neon-purple', 'to-neon-pink', 'text-white', 'border-neon-purple/50');
        btn.classList.add('bg-white/5', 'text-gray-400', 'hover:text-white', 'hover:bg-white/10', 'border', 'border-white/10', 'hover:border-neon-cyan/30');
      });

      setTimeout(() => {
        successMsg?.classList.add('hidden');
      }, 3000);
    } catch (error) {
      submitBtn?.removeAttribute('disabled');
      submitBtn?.classList.remove('opacity-50', 'cursor-not-allowed');
      submitText!.textContent = 'Subscribe';
      spinner?.classList.add('hidden');

      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Failed to subscribe. Please try again.';
        errorMsg.classList.remove('hidden');
      }

      setTimeout(() => {
        errorMsg?.classList.add('hidden');
      }, 5000);
    }
  });
</script>
