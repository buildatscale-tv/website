---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 bg-brutal-white dark:bg-brutal-black border-b-2 border-brutal-black dark:border-brutal-white">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <Logo />
        <div class="font-display font-bold text-2xl tracking-tight">
          Build<span class="text-brutal-accent">AtScale</span>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center gap-10">
        <a href="#latest" class="text-sm font-semibold uppercase tracking-widest hover:text-brutal-accent transition-colors">
          Videos
        </a>
        <a href="#about" class="text-sm font-semibold uppercase tracking-widest hover:text-brutal-accent transition-colors">
          About
        </a>
        <a href="#topics" class="text-sm font-semibold uppercase tracking-widest hover:text-brutal-accent transition-colors">
          Topics
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-4">
        <ThemeToggle />
        <a
          href="https://youtube.com/@buildatscale?sub_confirmation=1"
          target="_blank"
          rel="noopener"
          class="bg-brutal-black dark:bg-brutal-white text-brutal-white dark:text-brutal-black px-6 py-3 text-sm font-bold uppercase tracking-widest hover:bg-brutal-accent hover:text-brutal-white dark:hover:bg-brutal-accent dark:hover:text-brutal-white transition-colors"
        >
          Subscribe
        </a>
      </div>
    </div>
  </div>
</header>
