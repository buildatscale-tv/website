---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 glass border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="relative">
          <Logo />
          <div class="absolute inset-0 bg-accent-blue/20 blur-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        <div class="font-bold text-lg text-white">
          Build<span class="gradient-text">AtScale</span>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        <a href="#latest" class="px-4 py-2 text-sm text-gray-400 hover:text-white transition-colors rounded-lg hover:bg-white/5">
          Videos
        </a>
        <a href="#about" class="px-4 py-2 text-sm text-gray-400 hover:text-white transition-colors rounded-lg hover:bg-white/5">
          About
        </a>
        <a href="#topics" class="px-4 py-2 text-sm text-gray-400 hover:text-white transition-colors rounded-lg hover:bg-white/5">
          Topics
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center space-x-3">
        <ThemeToggle />
        <a
          href="https://youtube.com/@buildatscale?sub_confirmation=1"
          target="_blank"
          rel="noopener"
          class="relative group px-5 py-2 bg-gradient-to-r from-red-500 to-red-600 text-white text-sm font-medium rounded-lg overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-red-500/25"
        >
          <span class="relative z-10 flex items-center space-x-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>Subscribe</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>
