---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="main-header">
  <div class="absolute inset-0 bg-surface/80 backdrop-blur-xl border-b border-white/5"></div>
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-neon-cyan/30 to-transparent"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="relative">
          <Logo />
          <div class="absolute inset-0 animate-glow-pulse rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
        <div class="font-bold text-xl">
          <span class="text-white">Build</span><span class="text-neon-cyan">AtScale</span>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-1">
        <a href="#latest" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200">
          Videos
        </a>
        <a href="#about" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200">
          About
        </a>
        <a href="#topics" class="nav-link px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 transition-all duration-200">
          Topics
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center space-x-3">
        <ThemeToggle />
        <a
          href="https://youtube.com/@buildatscale?sub_confirmation=1"
          target="_blank"
          rel="noopener"
          class="btn-neon bg-gradient-to-r from-red-600 to-red-500 hover:from-red-500 hover:to-red-400 text-white px-5 py-2 rounded-lg font-medium transition-all duration-300 flex items-center space-x-2 text-sm"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Subscribe</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    
    if (currentScroll > 100) {
      header?.classList.add('shadow-lg', 'shadow-black/20');
    } else {
      header?.classList.remove('shadow-lg', 'shadow-black/20');
    }
    
    lastScroll = currentScroll;
  });
</script>
