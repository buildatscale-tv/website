---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="bg-warm-white/90 dark:bg-deep-charcoal/90 backdrop-blur-md border-b border-parchment dark:border-dark-parchment sticky top-0 z-50 transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <Logo />
        <div class="font-serif font-semibold text-2xl text-charcoal dark:text-warm-white tracking-tight">
          Build<span class="text-terracotta dark:text-terracotta-light">AtScale</span>
        </div>
      </a>

      <!-- Navigation -->
      <nav class="hidden md:flex items-center space-x-10">
        <a href="#latest" class="text-warm-gray dark:text-warm-gray-light hover:text-terracotta dark:hover:text-terracotta-light transition-colors duration-300 font-medium text-sm tracking-wide uppercase">
          Videos
        </a>
        <a href="#about" class="text-warm-gray dark:text-warm-gray-light hover:text-terracotta dark:hover:text-terracotta-light transition-colors duration-300 font-medium text-sm tracking-wide uppercase">
          About
        </a>
        <a href="#topics" class="text-warm-gray dark:text-warm-gray-light hover:text-terracotta dark:hover:text-terracotta-light transition-colors duration-300 font-medium text-sm tracking-wide uppercase">
          Topics
        </a>
      </nav>

      <!-- Actions -->
      <div class="flex items-center space-x-4">
        <ThemeToggle />
        <a
          href="https://youtube.com/@buildatscale?sub_confirmation=1"
          target="_blank"
          rel="noopener"
          class="group relative bg-terracotta hover:bg-terracotta-dark text-warm-white px-6 py-2.5 rounded-sm font-medium text-sm tracking-wide transition-all duration-300 overflow-hidden"
        >
          <span class="relative z-10 flex items-center space-x-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>Subscribe</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</header>
