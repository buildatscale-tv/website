---
const topics = [
  {
    label: "AI Tools & APIs",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`
  },
  {
    label: "Web Development",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`
  },
  {
    label: "DevOps & Infrastructure",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>`
  },
  {
    label: "Database Systems",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14a9 3 0 0 0 18 0V5"></path><path d="M3 12a9 3 0 0 0 18 0"></path></svg>`
  }
];
---

<section id="about" class="py-16 relative">
  <!-- Ambient glow -->
  <div class="absolute top-1/2 left-0 w-[400px] h-[400px] bg-neon-purple/5 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col sm:flex-row gap-6 items-center sm:items-start">
        <!-- Avatar with neon ring -->
        <div class="flex-shrink-0 w-[130px] h-[130px] rounded-full p-1 overflow-hidden" style="background: linear-gradient(135deg, #00f0ff, #b829f7);">
          <div class="w-full h-full rounded-full overflow-hidden bg-[#0a0a1a] border-2 border-space-900">
            <img
              src="/images/avatar-small.png"
              alt="Ronnie - BuildAtScale"
              class="w-full h-full object-cover scale-110 translate-x-[2px] translate-y-[8px]"
            />
          </div>
        </div>

        <!-- Text content -->
        <div>
          <span class="tag-badge mb-3 inline-block">ABOUT</span>
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-100 mb-6 text-center sm:text-left">
            About <span class="gradient-text">BuildAtScale</span>
          </h2>
          <div class="space-y-4 text-lg text-gray-400 leading-relaxed">
            <p>
              Lately I'm exploring how to stop writing every line of code myself and start directing
              AI agents to handle development, research, and deployment.
            </p>
            <p>
              Follow along if you're interested in building with AI tools, web development from front
              to back, DevOps and infrastructure workflows, and the awkward transition from coding
              to orchestrating AI systems.
            </p>
            <p>
              Hi, my name is Ronnie. I've been building web and software systems for about two decades.
              If there's one thing I've learned it's that the learning never stops. Join me in exploring
              the next wave and beyond.
            </p>
          </div>
        </div>
      </div>

      <div id="topics">
        <h3 class="text-2xl font-bold text-gray-100 mb-6">
          What You'll Find Here
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topics.map((topic) => (
            <div class="glass-panel glass-panel-hover rounded-xl p-4 group cursor-default">
              <div class="flex items-center space-x-3">
                <div class="text-neon-cyan group-hover:neon-text transition-all" set:html={topic.icon} />
                <span class="font-medium text-gray-100">{topic.label}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 p-6 glass-panel rounded-xl border-l-2 border-l-neon-cyan">
          <h4 class="font-semibold text-gray-100 mb-2 font-mono text-sm tracking-wider">
            Learning by Doing
          </h4>
          <p class="text-gray-400">
            Not being afraid to show the messy parts. Real experiments, real failures,
            and real discoveries in the world of AI-assisted development.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Subtle divider after about -->
<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex items-center gap-4 py-8">
    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-neon-cyan/20 to-transparent"></div>
    <div class="flex gap-1.5">
      <div class="w-1.5 h-1.5 rounded-full bg-neon-cyan/40"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-neon-purple/60"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-neon-cyan/40"></div>
    </div>
    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-neon-cyan/20 to-transparent"></div>
  </div>
</div>
