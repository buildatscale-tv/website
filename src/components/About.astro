---
const topics = [
  {
    label: "AI Tools & APIs",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`
  },
  {
    label: "Web Development",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`
  },
  {
    label: "DevOps & Infrastructure",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>`
  },
  {
    label: "Database Systems",
    icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14a9 3 0 0 0 18 0V5"></path><path d="M3 12a9 3 0 0 0 18 0"></path></svg>`
  }
];
---

<section id="about" class="py-24 bg-parchment/50 dark:bg-dark-parchment/30 transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col sm:flex-row gap-8 items-center sm:items-start">
        <!-- Avatar -->
        <div class="flex-shrink-0 w-[140px] h-[140px] rounded-full border-[3px] border-warm-white dark:border-warm-gray-dark shadow-xl overflow-hidden bg-[#1e3049]">
          <img
            src="/images/avatar-small.png"
            alt="Ronnie - BuildAtScale"
            class="w-full h-full object-cover scale-110 translate-x-[2px] translate-y-[8px]"
          />
        </div>

        <!-- Text content -->
        <div>
          <p class="text-terracotta dark:text-terracotta-light font-medium text-sm tracking-widest-xl uppercase mb-4">
            The Editor
          </p>
          <h2 class="font-serif text-4xl lg:text-5xl font-medium text-charcoal dark:text-warm-white mb-8 text-center sm:text-left leading-tight">
            About BuildAtScale
          </h2>
          <div class="space-y-5 text-warm-gray-dark dark:text-warm-gray-light leading-[1.8] text-base">
            <p>
              Lately I'm exploring how to stop writing every line of code myself and start directing
              AI agents to handle development, research, and deployment.
            </p>
            <p>
              Follow along if you're interested in building with AI tools, web development from front
              to back, DevOps and infrastructure workflows, and the awkward transition from coding
              to orchestrating AI systems.
            </p>
            <p>
              Hi, my name is Ronnie. I've been building web and software systems for about two decades.
              If there's one thing I've learned it's that the learning never stops. Join me in exploring
              the next wave and beyond.
            </p>
          </div>
        </div>
      </div>

      <div id="topics">
        <p class="text-forest dark:text-forest-light font-medium text-sm tracking-widest-xl uppercase mb-4">
          Coverage
        </p>
        <h3 class="font-serif text-3xl lg:text-4xl font-medium text-charcoal dark:text-warm-white mb-8 leading-tight">
          What You'll Find Here
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topics.map((topic) => (
            <div class="group bg-warm-white dark:bg-dark-parchment/60 backdrop-blur-sm border border-parchment dark:border-warm-gray-dark/30 rounded-sm p-5 hover:shadow-lg hover:shadow-terracotta/5 dark:hover:shadow-terracotta/10 transition-all duration-300 cursor-default">
              <div class="flex items-center space-x-4">
                <div class="text-terracotta dark:text-terracotta-light transition-transform duration-300 group-hover:scale-110" set:html={topic.icon} />
                <span class="font-medium text-charcoal dark:text-warm-white text-sm tracking-wide">{topic.label}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 p-8 bg-warm-white dark:bg-dark-parchment/60 backdrop-blur-sm border-l-4 border-terracotta dark:border-terracotta-light rounded-sm">
          <h4 class="font-serif font-medium text-xl text-charcoal dark:text-warm-white mb-3">
            Learning by Doing
          </h4>
          <p class="text-warm-gray-dark dark:text-warm-gray-light leading-relaxed">
            Not being afraid to show the messy parts. Real experiments, real failures,
            and real discoveries in the world of AI-assisted development.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Subtle divider after about -->
<div class="bg-parchment/50 dark:bg-dark-parchment/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6 py-12">
      <div class="flex-1 h-px bg-gradient-to-r from-transparent via-terracotta/20 to-transparent"></div>
      <div class="flex gap-2">
        <div class="w-2 h-2 rounded-full bg-terracotta/40 dark:bg-terracotta-light/40"></div>
        <div class="w-2 h-2 rounded-full bg-gold/60 dark:bg-gold-light/60"></div>
        <div class="w-2 h-2 rounded-full bg-forest/40 dark:bg-forest-light/40"></div>
      </div>
      <div class="flex-1 h-px bg-gradient-to-r from-transparent via-terracotta/20 to-transparent"></div>
    </div>
  </div>
</div>
