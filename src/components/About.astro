---
const topics = [
  {
    label: "AI Tools & APIs",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`,
    color: "from-blue-500 to-cyan-500"
  },
  {
    label: "Web Development",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>`,
    color: "from-purple-500 to-pink-500"
  },
  {
    label: "DevOps & Infrastructure",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>`,
    color: "from-green-500 to-emerald-500"
  },
  {
    label: "Database Systems",
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14a9 3 0 0 0 18 0V5"></path><path d="M3 12a9 3 0 0 0 18 0"></path></svg>`,
    color: "from-orange-500 to-red-500"
  }
];
---

<section id="about" class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-surface-1"></div>
  <div class="absolute inset-0 grid-pattern opacity-20"></div>
  
  <!-- Decorative elements -->
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-accent-purple/5 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-accent-blue/5 rounded-full blur-3xl"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left column - About text -->
      <div class="reveal-on-scroll">
        <div class="flex flex-col sm:flex-row gap-8 items-center sm:items-start">
          <!-- Avatar -->
          <div class="flex-shrink-0 relative">
            <div class="w-32 h-32 rounded-2xl overflow-hidden border-2 border-white/10">
              <img
                src="/images/avatar-small.png"
                alt="Ronnie - BuildAtScale"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-green-500 rounded-full border-4 border-surface-1"></div>
          </div>

          <!-- Text content -->
          <div>
            <h2 class="text-4xl lg:text-5xl font-bold text-white mb-6">
              About <span class="gradient-text">BuildAtScale</span>
            </h2>
            <div class="space-y-5 text-gray-400 leading-relaxed">
              <p>
                Lately I'm exploring how to stop writing every line of code myself and start directing
                AI agents to handle development, research, and deployment.
              </p>
              <p>
                Follow along if you're interested in building with AI tools, web development from front
                to back, DevOps and infrastructure workflows, and the awkward transition from coding
                to orchestrating AI systems.
              </p>
              <p>
                Hi, my name is Ronnie. I've been building web and software systems for about two decades.
                If there's one thing I've learned it's that the learning never stops. Join me in exploring
                the next wave and beyond.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right column - Topics -->
      <div id="topics" class="reveal-on-scroll">
        <h3 class="text-2xl font-bold text-white mb-8">
          What You'll Find Here
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {topics.map((topic) => (
            <div class="group relative bg-surface-2 rounded-xl p-5 border border-white/5 hover:border-white/10 transition-all duration-300 hover:shadow-lg">
              <div class="flex items-center space-x-4">
                <div class={`w-10 h-10 rounded-lg bg-gradient-to-r ${topic.color} flex items-center justify-center text-white`}>
                  <Fragment set:html={topic.icon} />
                </div>
                <span class="font-medium text-white">{topic.label}</span>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-8 p-6 bg-surface-2 rounded-xl border border-white/5">
          <h4 class="font-semibold text-white mb-3 flex items-center space-x-2">
            <svg class="w-5 h-5 text-accent-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
            <span>Learning by Doing</span>
          </h4>
          <p class="text-gray-400">
            Not being afraid to show the messy parts. Real experiments, real failures,
            and real discoveries in the world of AI-assisted development.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
