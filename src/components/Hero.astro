---
---

<section class="relative pt-28 pb-20 overflow-hidden transition-colors duration-500">
  <!-- Subtle warm gradient background -->
  <div class="absolute inset-0 bg-gradient-to-b from-parchment/60 via-cream to-cream dark:from-dark-parchment/60 dark:via-deep-charcoal dark:to-deep-charcoal transition-colors duration-500"></div>
  
  <!-- Decorative accent line -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-terracotta/30 to-transparent"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <!-- Overline -->
      <p class="text-terracotta dark:text-terracotta-light font-medium text-sm tracking-widest-xl uppercase mb-8">
        BuildAtScale — A Journal of Building in the Open
      </p>
      
      <h1 class="font-serif text-6xl lg:text-8xl font-medium text-charcoal dark:text-warm-white mb-8 leading-[0.95] tracking-tight">
        Learning in<br />
        <span class="italic text-terracotta dark:text-terracotta-light">Public</span>
      </h1>
      
      <p class="font-serif text-2xl lg:text-3xl text-warm-gray dark:text-warm-gray-light mb-6 max-w-3xl mx-auto italic">
        AI • Web • Ops
      </p>
      
      <p class="text-lg text-warm-gray-dark dark:text-warm-gray-light mb-12 max-w-2xl mx-auto leading-relaxed">
        Sharing what I'm building, breaking, and learning. From LLM experiments and web dev deep dives
        to DevOps automation and shipping fast.
      </p>
      
      <div class="flex flex-col sm:flex-row items-center justify-center space-y-4 sm:space-y-0 sm:space-x-6">
        <a
          href="https://youtube.com/@buildatscale"
          target="_blank"
          rel="noopener"
          class="group relative bg-terracotta hover:bg-terracotta-dark text-warm-white px-10 py-4 rounded-sm font-medium transition-all duration-300 flex items-center space-x-3 overflow-hidden"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Watch on YouTube</span>
        </a>
        <a
          href="#latest"
          class="group border-2 border-charcoal dark:border-warm-gray-light text-charcoal dark:text-warm-white hover:bg-charcoal hover:text-warm-white dark:hover:bg-warm-white dark:hover:text-deep-charcoal px-10 py-4 rounded-sm font-medium transition-all duration-300"
        >
          Browse Videos
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom decorative element -->
  <div class="absolute bottom-0 left-0 right-0 flex items-center justify-center pb-4">
    <div class="w-px h-16 bg-gradient-to-b from-terracotta/40 to-transparent"></div>
  </div>
</section>
