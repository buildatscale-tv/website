<section class="bg-gradient-to-b from-blue-50 to-white dark:from-slate-800 dark:to-slate-900 pt-24 pb-16 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h1 class="text-display lg:text-display-lg text-gray-900 dark:text-gray-100 mb-6 animate-fade-in">
        Learning in Public
      </h1>
      <p class="text-body-lg text-gray-600 dark:text-gray-400 mb-3 max-w-4xl mx-auto animate-fade-in-up">
        AI <span class="text-blue-500 dark:text-blue-400 mx-2">•</span> Web <span class="text-blue-500 dark:text-blue-400 mx-2">•</span> Ops
      </p>
      <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-10 max-w-3xl mx-auto leading-relaxed animate-fade-in-up">
        Sharing what I'm building, breaking, and learning. From LLM experiments and web dev deep dives
        to DevOps automation and shipping fast.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center space-y-4 sm:space-y-0 sm:space-x-4 animate-fade-in-up">
        <a
          href="https://youtube.com/@buildatscale"
          target="_blank"
          rel="noopener"
          class="bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 text-white px-8 py-3.5 rounded-xl font-medium transition-all duration-200 flex items-center space-x-2 shadow-md hover:shadow-lg active:scale-[0.97] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
          </svg>
          <span>Watch on YouTube</span>
        </a>
        <a
          href="#latest"
          class="border-2 border-blue-600 dark:border-blue-500 text-blue-600 dark:text-blue-400 hover:bg-blue-600 dark:hover:bg-blue-500 hover:text-white px-8 py-3.5 rounded-xl font-medium transition-all duration-200 active:scale-[0.97] focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
        >
          Browse Videos
        </a>
      </div>
    </div>
  </div>
</section>
