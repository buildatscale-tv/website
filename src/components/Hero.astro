---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
  <!-- Animated background orbs -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="orb orb-1 top-1/4 -left-20"></div>
    <div class="orb orb-2 top-1/3 right-10"></div>
    <div class="orb orb-3 bottom-1/4 left-1/3"></div>
  </div>

  <!-- Radial gradient overlay -->
  <div class="absolute inset-0 bg-gradient-radial from-neon-cyan/5 via-transparent to-transparent opacity-50"></div>

  <!-- Grid pattern -->
  <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 1px 1px, rgba(0, 240, 255, 0.15) 1px, transparent 0); background-size: 40px 40px;"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Terminal-style badge -->
    <div class="inline-flex items-center gap-2 mb-8 animate-fade-in">
      <span class="pill-badge">
        <span class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
        Now Streaming
      </span>
    </div>

    <!-- Main heading -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black mb-6 animate-slide-up tracking-tight">
      <span class="block text-white">Learning</span>
      <span class="block gradient-text">in Public</span>
    </h1>

    <!-- Subtitle with terminal style -->
    <div class="font-mono text-sm sm:text-base text-neon-cyan/80 mb-6 animate-slide-up" style="animation-delay: 0.2s">
      <span class="terminal-prompt">AI</span> • <span class="terminal-prompt">Web</span> • <span class="terminal-prompt">Ops</span>
    </div>

    <!-- Description -->
    <p class="text-lg sm:text-xl text-gray-400 max-w-2xl mx-auto mb-10 animate-slide-up leading-relaxed" style="animation-delay: 0.3s">
      Sharing what I'm building, breaking, and learning. From LLM experiments and web dev deep dives
      to DevOps automation and shipping fast.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.4s">
      <a
        href="https://youtube.com/@buildatscale"
        target="_blank"
        rel="noopener"
        class="btn-neon group relative inline-flex items-center gap-3 bg-gradient-to-r from-neon-cyan to-neon-blue text-surface px-8 py-4 rounded-xl font-bold text-lg transition-all duration-300"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
        <span>Watch on YouTube</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
      <a
        href="#latest"
        class="group inline-flex items-center gap-2 px-8 py-4 rounded-xl font-medium text-lg border border-white/10 hover:border-neon-cyan/50 text-white hover:text-neon-cyan transition-all duration-300 hover:bg-white/5"
      >
        <span>Browse Videos</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
        </svg>
      </a>
    </div>

    <!-- Stats -->
    <div class="mt-16 grid grid-cols-3 gap-8 max-w-lg mx-auto animate-fade-in" style="animation-delay: 0.6s">
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-bold text-white">AI</div>
        <div class="text-xs sm:text-sm text-gray-500 mt-1">Workflows</div>
      </div>
      <div class="text-center border-x border-white/10">
        <div class="text-2xl sm:text-3xl font-bold text-white">Dev</div>
        <div class="text-xs sm:text-sm text-gray-500 mt-1">Experiments</div>
      </div>
      <div class="text-center">
        <div class="text-2xl sm:text-3xl font-bold text-white">Scale</div>
        <div class="text-xs sm:text-sm text-gray-500 mt-1">Strategies</div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <div class="w-6 h-10 rounded-full border-2 border-white/20 flex items-start justify-center p-1">
      <div class="w-1.5 h-3 bg-neon-cyan rounded-full animate-pulse"></div>
    </div>
  </div>
</section>
