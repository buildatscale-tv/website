---
const requestTypes = [
  'Video Request',
  'Tool/Service Review',
  'Collaboration Idea',
  'Sponsored Video RFP',
  'Other'
];
---

<section class="relative py-20 px-4 sm:px-6 lg:px-8 section-transition">
  <!-- Background glow -->
  <div class="absolute inset-0 bg-gradient-radial from-neon-orange/5 via-transparent to-transparent opacity-50"></div>

  <div class="relative z-10 max-w-3xl mx-auto">
    <div class="text-center mb-12 reveal">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="pill-badge" style="border-color: rgba(255, 107, 53, 0.3); color: #ff6b35; background: rgba(255, 107, 53, 0.1);">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
          </svg>
          Get in Touch
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        Have an <span class="gradient-text">Idea</span>?
      </h2>
      <p class="text-lg text-gray-400 max-w-xl mx-auto">
        Suggest a topic, share a problem you're facing, or request a video.
        I'm always looking for real-world challenges to explore.
      </p>
    </div>

    <div class="glass-card rounded-2xl p-8 reveal">
      <form id="request-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-400 mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="input-glow w-full px-4 py-3 rounded-xl text-white placeholder-gray-500"
              placeholder="Your name"
              required
            />
          </div>
          <div>
            <label for="request-email" class="block text-sm font-medium text-gray-400 mb-2">
              Email
            </label>
            <input
              type="email"
              id="request-email"
              name="email"
              class="input-glow w-full px-4 py-3 rounded-xl text-white placeholder-gray-500"
              placeholder="you@example.com"
              required
            />
          </div>
        </div>

        <div>
          <label for="type" class="block text-sm font-medium text-gray-400 mb-2">
            Request Type
          </label>
          <select
            id="type"
            name="type"
            class="input-glow w-full px-4 py-3 rounded-xl text-white appearance-none cursor-pointer [&>option]:bg-surface-lighter [&>option]:text-white"
          >
            {requestTypes.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-400 mb-2">
            Details
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="input-glow w-full px-4 py-3 rounded-xl text-white placeholder-gray-500 resize-none"
            placeholder="Describe your idea, problem, or request in detail..."
            required
          ></textarea>
        </div>

        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between">
            <button
              type="submit"
              id="request-submit"
              class="btn-neon bg-gradient-to-r from-neon-cyan to-neon-blue text-surface px-8 py-3 rounded-xl font-semibold transition-all duration-300"
            >
              <span id="request-submit-text">Submit Request</span>
              <div class="w-4 h-4 border-2 border-surface/30 border-t-surface rounded-full animate-spin hidden inline-block ml-2" id="request-spinner"></div>
            </button>

            <div id="request-success" class="text-neon-green font-medium flex items-center gap-2 hidden">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Request submitted successfully!</span>
            </div>
          </div>

          <div id="request-error" class="text-neon-pink font-medium text-sm hidden"></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('request-form');
  const submitBtn = document.getElementById('request-submit');
  const submitText = document.getElementById('request-submit-text');
  const spinner = document.getElementById('request-spinner');
  const successMsg = document.getElementById('request-success');
  const errorMsg = document.getElementById('request-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn?.setAttribute('disabled', 'true');
    submitBtn?.classList.add('opacity-50', 'cursor-not-allowed');
    submitText!.textContent = 'Sending...';
    spinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const formData = new FormData(e.target as HTMLFormElement);
      const response = await fetch('/api/submit-request', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to submit request');
      }

      submitBtn?.removeAttribute('disabled');
      submitBtn?.classList.remove('opacity-50', 'cursor-not-allowed');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      (e.target as HTMLFormElement).reset();

      setTimeout(() => {
        successMsg?.classList.add('hidden');
      }, 3000);
    } catch (error) {
      submitBtn?.removeAttribute('disabled');
      submitBtn?.classList.remove('opacity-50', 'cursor-not-allowed');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');

      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Failed to submit request. Please try again.';
        errorMsg.classList.remove('hidden');
      }

      setTimeout(() => {
        errorMsg?.classList.add('hidden');
      }, 5000);
    }
  });
</script>
