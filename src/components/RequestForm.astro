---
const requestTypes = [
  'Video Request',
  'Tool/Service Review',
  'Collaboration Idea',
  'Sponsored Video RFP',
  'Other'
];
---

<section class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 bg-surface-0"></div>
  <div class="absolute inset-0 grid-pattern opacity-20"></div>
  
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 reveal-on-scroll">
      <h2 class="text-4xl lg:text-5xl font-bold text-white mb-4">
        Have an <span class="gradient-text">Idea</span>?
      </h2>
      <p class="text-lg text-gray-400 max-w-2xl mx-auto">
        Suggest a topic, share a problem you're facing, or request a video.
        I'm always looking for real-world challenges to explore.
      </p>
    </div>

    <div class="reveal-on-scroll bg-surface-2 rounded-2xl p-8 border border-white/5">
      <form id="request-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-400 mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 bg-surface-3 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue/50 focus:border-accent-blue/50 transition-all"
              required
            />
          </div>
          <div>
            <label for="request-email" class="block text-sm font-medium text-gray-400 mb-2">
              Email
            </label>
            <input
              type="email"
              id="request-email"
              name="email"
              class="w-full px-4 py-3 bg-surface-3 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue/50 focus:border-accent-blue/50 transition-all"
              required
            />
          </div>
        </div>

        <div>
          <label for="type" class="block text-sm font-medium text-gray-400 mb-2">
            Request Type
          </label>
          <select
            id="type"
            name="type"
            class="w-full px-4 py-3 bg-surface-3 border border-white/10 rounded-xl text-white focus:ring-2 focus:ring-accent-blue/50 focus:border-accent-blue/50 transition-all"
          >
            {requestTypes.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-400 mb-2">
            Details
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full px-4 py-3 bg-surface-3 border border-white/10 rounded-xl text-white placeholder-gray-500 focus:ring-2 focus:ring-accent-blue/50 focus:border-accent-blue/50 transition-all"
            placeholder="Describe your idea, problem, or request in detail..."
            required
          ></textarea>
        </div>

        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between">
            <button
              type="submit"
              id="request-submit"
              class="px-8 py-3 bg-gradient-to-r from-accent-blue to-accent-cyan text-white font-medium rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-accent-blue/25 flex items-center space-x-2"
            >
              <span id="request-submit-text">Submit Request</span>
              <div class="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin hidden" id="request-spinner"></div>
            </button>

            <div id="request-success" class="text-green-400 font-medium flex items-center space-x-2 hidden">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Message sent successfully!</span>
            </div>
          </div>

          <div id="request-error" class="text-red-400 font-medium text-sm hidden"></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('request-form');
  const submitBtn = document.getElementById('request-submit');
  const submitText = document.getElementById('request-submit-text');
  const spinner = document.getElementById('request-spinner');
  const successMsg = document.getElementById('request-success');
  const errorMsg = document.getElementById('request-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show loading state
    submitBtn?.setAttribute('disabled', 'true');
    submitText!.textContent = 'Sending...';
    spinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      // Prepare form data
      const formData = new FormData(e.target as HTMLFormElement);

      // Submit to API endpoint
      const response = await fetch('/api/submit-request', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to send message');
      }

      // Show success state
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      // Reset form
      (e.target as HTMLFormElement).reset();

      // Hide success message after 3 seconds
      setTimeout(() => {
        successMsg?.classList.add('hidden');
      }, 3000);
    } catch (error) {
      // Show error state
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');

      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Failed to send message. Please try again.';
        errorMsg.classList.remove('hidden');
      }

      // Hide error message after 5 seconds
      setTimeout(() => {
        errorMsg?.classList.add('hidden');
      }, 5000);
    }
  });
</script>
