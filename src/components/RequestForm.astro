---
const requestTypes = [
  'Video Request',
  'Tool/Service Review',
  'Collaboration Idea',
  'Sponsored Video RFP',
  'Other'
];
---

<section class="py-12">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="tag-badge mb-4 inline-block">TRANSMIT</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-100 mb-4">
        Have an Idea or <span class="gradient-text">Request</span>?
      </h2>
      <p class="text-lg text-gray-500">
        Suggest a topic, share a problem you're facing, or request a video.
        I'm always looking for real-world challenges to explore.
      </p>
    </div>

    <div class="glass-panel rounded-xl p-8 neon-glow">
      <form id="request-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block text-sm font-medium text-gray-400 mb-2 font-mono tracking-wider">
              NAME
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 bg-space-800/50 border border-white/10 text-gray-100 rounded-lg focus:ring-2 focus:ring-neon-cyan/50 focus:border-neon-cyan/30 transition-all placeholder-gray-600"
              required
            />
          </div>
          <div>
            <label for="request-email" class="block text-sm font-medium text-gray-400 mb-2 font-mono tracking-wider">
              EMAIL
            </label>
            <input
              type="email"
              id="request-email"
              name="email"
              class="w-full px-4 py-3 bg-space-800/50 border border-white/10 text-gray-100 rounded-lg focus:ring-2 focus:ring-neon-cyan/50 focus:border-neon-cyan/30 transition-all placeholder-gray-600"
              required
            />
          </div>
        </div>

        <div>
          <label for="type" class="block text-sm font-medium text-gray-400 mb-2 font-mono tracking-wider">
            REQUEST_TYPE
          </label>
          <select
            id="type"
            name="type"
            class="w-full px-4 py-3 bg-space-800/50 border border-white/10 text-gray-100 rounded-lg focus:ring-2 focus:ring-neon-cyan/50 focus:border-neon-cyan/30 transition-all [&>option]:bg-space-800 [&>option]:text-gray-100"
          >
            {requestTypes.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-gray-400 mb-2 font-mono tracking-wider">
            DETAILS
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full px-4 py-3 bg-space-800/50 border border-white/10 text-gray-100 rounded-lg focus:ring-2 focus:ring-neon-cyan/50 focus:border-neon-cyan/30 transition-all placeholder-gray-600"
            placeholder="Describe your idea, problem, or request in detail..."
            required
          ></textarea>
        </div>

        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between">
            <button
              type="submit"
              id="request-submit"
              class="btn-primary px-8 py-3 rounded-lg font-medium flex items-center space-x-2"
            >
              <span class="relative z-10" id="request-submit-text">Submit Request</span>
              <div class="w-4 h-4 border-2 border-space-900 border-t-transparent rounded-full animate-spin hidden relative z-10" id="request-spinner"></div>
            </button>

            <div id="request-success" class="text-neon-cyan font-medium flex items-center space-x-2 hidden">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Request submitted successfully!</span>
            </div>
          </div>

          <div id="request-error" class="text-neon-pink font-medium text-sm hidden"></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('request-form');
  const submitBtn = document.getElementById('request-submit');
  const submitText = document.getElementById('request-submit-text');
  const spinner = document.getElementById('request-spinner');
  const successMsg = document.getElementById('request-success');
  const errorMsg = document.getElementById('request-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show loading state
    submitBtn?.setAttribute('disabled', 'true');
    submitText!.textContent = 'Sending...';
    spinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      // Submit form data to API endpoint
      const formData = new FormData(e.target as HTMLFormElement);
      const response = await fetch('/api/submit-request', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to submit request');
      }

      // Show success state
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      // Reset form
      (e.target as HTMLFormElement).reset();

      // Hide success message after 3 seconds
      setTimeout(() => {
        successMsg?.classList.add('hidden');
      }, 3000);
    } catch (error) {
      // Show error state
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');

      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Failed to submit request. Please try again.';
        errorMsg.classList.remove('hidden');
      }

      // Hide error message after 5 seconds
      setTimeout(() => {
        errorMsg?.classList.add('hidden');
      }, 5000);
    }
  });
</script>
