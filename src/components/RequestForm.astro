---
const requestTypes = [
  'Video Request',
  'Tool/Service Review',
  'Collaboration Idea',
  'Sponsored Video RFP',
  'Other'
];
---

<section class="py-24 bg-parchment/50 dark:bg-dark-parchment/30 transition-colors duration-500">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <p class="text-forest dark:text-forest-light font-medium text-sm tracking-widest-xl uppercase mb-4">
        Correspondence
      </p>
      <h2 class="font-serif text-4xl lg:text-5xl font-medium text-charcoal dark:text-warm-white mb-6 leading-tight">
        Have an Idea or Request?
      </h2>
      <p class="text-lg text-warm-gray-dark dark:text-warm-gray-light max-w-2xl mx-auto leading-relaxed">
        Suggest a topic, share a problem you're facing, or request a video.
        I'm always looking for real-world challenges to explore.
      </p>
    </div>

    <div class="bg-warm-white dark:bg-dark-parchment/60 backdrop-blur-sm rounded-sm p-10 shadow-xl shadow-charcoal/5 dark:shadow-black/20 border border-parchment dark:border-warm-gray-dark/30">
      <form id="request-form" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label for="name" class="block text-sm font-medium text-warm-gray-dark dark:text-warm-gray-light mb-3 tracking-wide uppercase">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-5 py-4 bg-cream dark:bg-deep-charcoal border border-parchment dark:border-warm-gray-dark/50 rounded-sm text-charcoal dark:text-warm-white placeholder-warm-gray-light dark:placeholder-warm-gray-dark focus:ring-2 focus:ring-forest/50 focus:border-forest dark:focus:border-forest-light transition-all duration-300 outline-none"
              required
            />
          </div>
          <div>
            <label for="request-email" class="block text-sm font-medium text-warm-gray-dark dark:text-warm-gray-light mb-3 tracking-wide uppercase">
              Email
            </label>
            <input
              type="email"
              id="request-email"
              name="email"
              class="w-full px-5 py-4 bg-cream dark:bg-deep-charcoal border border-parchment dark:border-warm-gray-dark/50 rounded-sm text-charcoal dark:text-warm-white placeholder-warm-gray-light dark:placeholder-warm-gray-dark focus:ring-2 focus:ring-forest/50 focus:border-forest dark:focus:border-forest-light transition-all duration-300 outline-none"
              required
            />
          </div>
        </div>

        <div>
          <label for="type" class="block text-sm font-medium text-warm-gray-dark dark:text-warm-gray-light mb-3 tracking-wide uppercase">
            Request Type
          </label>
          <select
            id="type"
            name="type"
            class="w-full px-5 py-4 bg-cream dark:bg-deep-charcoal border border-parchment dark:border-warm-gray-dark/50 rounded-sm text-charcoal dark:text-warm-white focus:ring-2 focus:ring-forest/50 focus:border-forest dark:focus:border-forest-light transition-all duration-300 outline-none appearance-none cursor-pointer"
          >
            {requestTypes.map((type) => (
              <option value={type} class="bg-cream dark:bg-deep-charcoal text-charcoal dark:text-warm-white">{type}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-warm-gray-dark dark:text-warm-gray-light mb-3 tracking-wide uppercase">
            Details
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            class="w-full px-5 py-4 bg-cream dark:bg-deep-charcoal border border-parchment dark:border-warm-gray-dark/50 rounded-sm text-charcoal dark:text-warm-white focus:ring-2 focus:ring-forest/50 focus:border-forest dark:focus:border-forest-light transition-all duration-300 outline-none placeholder-warm-gray-light dark:placeholder-warm-gray-dark resize-y"
            placeholder="Describe your idea, problem, or request in detail..."
            required
          ></textarea>
        </div>

        <div class="flex flex-col space-y-6">
          <div class="flex items-center justify-between">
            <button
              type="submit"
              id="request-submit"
              class="bg-forest hover:bg-forest-dark disabled:bg-forest/60 text-warm-white px-10 py-4 rounded-sm font-medium transition-all duration-300 flex items-center space-x-3 tracking-wide"
            >
              <span id="request-submit-text">Submit Request</span>
              <div class="w-4 h-4 border-2 border-warm-white border-t-transparent rounded-full animate-spin hidden" id="request-spinner"></div>
            </button>

            <div id="request-success" class="text-forest dark:text-forest-light font-medium flex items-center space-x-2 hidden">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Request submitted successfully!</span>
            </div>
          </div>

          <div id="request-error" class="text-terracotta dark:text-terracotta-light font-medium text-sm hidden"></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('request-form');
  const submitBtn = document.getElementById('request-submit');
  const submitText = document.getElementById('request-submit-text');
  const spinner = document.getElementById('request-spinner');
  const successMsg = document.getElementById('request-success');
  const errorMsg = document.getElementById('request-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Show loading state
    submitBtn?.setAttribute('disabled', 'true');
    submitText!.textContent = 'Sending...';
    spinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      // Submit form data to API endpoint
      const formData = new FormData(e.target as HTMLFormElement);
      const response = await fetch('/api/submit-request', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to submit request');
      }

      // Show success state
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      // Reset form
      (e.target as HTMLFormElement).reset();

      // Hide success message after 3 seconds
      setTimeout(() => {
        successMsg?.classList.add('hidden');
      }, 3000);
    } catch (error) {
      // Show error state
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');

      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Failed to submit request. Please try again.';
        errorMsg.classList.remove('hidden');
      }

      // Hide error message after 5 seconds
      setTimeout(() => {
        errorMsg?.classList.add('hidden');
      }, 5000);
    }
  });
</script>
