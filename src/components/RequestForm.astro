---
const requestTypes = [
  'Video Request',
  'Tool/Service Review',
  'Collaboration Idea',
  'Sponsored Video RFP',
  'Other'
];
---

<section class="py-24 px-6 lg:px-8 border-t-2 border-brutal-black dark:border-brutal-white bg-brutal-gray dark:bg-brutal-gray-dark">
  <div class="max-w-4xl mx-auto">
    <div class="mb-16">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brutal-accent mb-6">Contact</p>
      <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight mb-6">
        Have an Idea or Request?
      </h2>
      <p class="text-lg max-w-xl text-brutal-black/70 dark:text-brutal-white/70">
        Suggest a topic, share a problem you're facing, or request a video.
        I'm always looking for real-world challenges to explore.
      </p>
    </div>

    <div class="border-2 border-brutal-black dark:border-brutal-white p-8 md:p-12 bg-brutal-white dark:bg-brutal-black">
      <form id="request-form" class="space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-widest mb-3">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 border-2 border-brutal-black dark:border-brutal-white bg-transparent text-brutal-black dark:text-brutal-white focus:border-brutal-accent dark:focus:border-brutal-accent outline-none transition-colors"
              required
            />
          </div>
          <div>
            <label for="request-email" class="block text-xs font-bold uppercase tracking-widest mb-3">
              Email
            </label>
            <input
              type="email"
              id="request-email"
              name="email"
              class="w-full px-4 py-3 border-2 border-brutal-black dark:border-brutal-white bg-transparent text-brutal-black dark:text-brutal-white focus:border-brutal-accent dark:focus:border-brutal-accent outline-none transition-colors"
              required
            />
          </div>
        </div>

        <div>
          <label for="type" class="block text-xs font-bold uppercase tracking-widest mb-3">
            Request Type
          </label>
          <select
            id="type"
            name="type"
            class="w-full px-4 py-3 border-2 border-brutal-black dark:border-brutal-white bg-brutal-white dark:bg-brutal-black text-brutal-black dark:text-brutal-white focus:border-brutal-accent dark:focus:border-brutal-accent outline-none transition-colors"
          >
            {requestTypes.map((type) => (
              <option value={type}>{type}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="message" class="block text-xs font-bold uppercase tracking-widest mb-3">
            Details
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full px-4 py-3 border-2 border-brutal-black dark:border-brutal-white bg-transparent text-brutal-black dark:text-brutal-white focus:border-brutal-accent dark:focus:border-brutal-accent outline-none transition-colors placeholder:text-brutal-black/40 dark:placeholder:text-brutal-white/40"
            placeholder="Describe your idea, problem, or request in detail..."
            required
          ></textarea>
        </div>

        <div class="flex flex-col space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <button
              type="submit"
              id="request-submit"
              class="bg-brutal-black dark:bg-brutal-white text-brutal-white dark:text-brutal-black px-8 py-4 text-sm font-bold uppercase tracking-widest hover:bg-brutal-accent hover:text-brutal-white dark:hover:bg-brutal-accent dark:hover:text-brutal-white transition-colors flex items-center gap-3"
            >
              <span id="request-submit-text">Submit Request</span>
              <div class="w-4 h-4 border-2 border-brutal-white dark:border-brutal-black border-t-transparent rounded-full animate-spin hidden" id="request-spinner"></div>
            </button>

            <div id="request-success" class="text-brutal-accent font-bold flex items-center gap-2 hidden">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              <span>Request submitted successfully!</span>
            </div>
          </div>

          <div id="request-error" class="text-brutal-accent font-bold text-sm hidden"></div>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('request-form');
  const submitBtn = document.getElementById('request-submit');
  const submitText = document.getElementById('request-submit-text');
  const spinner = document.getElementById('request-spinner');
  const successMsg = document.getElementById('request-success');
  const errorMsg = document.getElementById('request-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn?.setAttribute('disabled', 'true');
    submitText!.textContent = 'Sending...';
    spinner?.classList.remove('hidden');
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    try {
      const formData = new FormData(e.target as HTMLFormElement);
      const response = await fetch('/api/submit-request', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.error || 'Failed to submit request');
      }

      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');
      successMsg?.classList.remove('hidden');

      (e.target as HTMLFormElement).reset();

      setTimeout(() => {
        successMsg?.classList.add('hidden');
      }, 3000);
    } catch (error) {
      submitBtn?.removeAttribute('disabled');
      submitText!.textContent = 'Submit Request';
      spinner?.classList.add('hidden');

      if (errorMsg) {
        errorMsg.textContent = error instanceof Error ? error.message : 'Failed to submit request. Please try again.';
        errorMsg.classList.remove('hidden');
      }

      setTimeout(() => {
        errorMsg?.classList.add('hidden');
      }, 5000);
    }
  });
</script>
