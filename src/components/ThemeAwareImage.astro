---
export interface Props {
  lightSrc: string;
  darkSrc: string;
  alt?: string;
  class?: string;
}

const { lightSrc, darkSrc, alt = "", class: className = "" } = Astro.props;
---

<img src={lightSrc} alt={alt} class={`w-full h-auto block theme-aware-img border-2 border-brutal-black dark:border-brutal-white ${className}`} data-light-src={lightSrc} data-dark-src={darkSrc} />

<script>
  function updateThemeAwareImages() {
    const isDark = document.documentElement.classList.contains('dark');
    const images = document.querySelectorAll('.theme-aware-img');

    images.forEach((img) => {
      if (img instanceof HTMLImageElement) {
        const lightSrc = img.getAttribute('data-light-src');
        const darkSrc = img.getAttribute('data-dark-src');

        if (lightSrc && darkSrc) {
          img.src = isDark ? darkSrc : lightSrc;
        }
      }
    });
  }

  updateThemeAwareImages();

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'class') {
        updateThemeAwareImages();
      }
    });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>
