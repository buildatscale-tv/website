---
import { formatViews, formatLikes, getTimeAgo } from '../utils/youtube';

export interface Props {
  videoId: string;
  title: string;
  thumbnail: string;
  duration?: string;
  viewCount?: number;
  likeCount?: number;
  publishedAt: string;
}

const { videoId, title, thumbnail, duration, viewCount, likeCount, publishedAt } = Astro.props;

const views = formatViews(viewCount);
const likes = formatLikes(likeCount);
const timeAgo = getTimeAgo(publishedAt);
---

<button
  type="button"
  onclick={`openVideoModal('${videoId}', '${title.replace(/'/g, "\\'")}')`}
  class="group cursor-pointer block w-full text-left border-2 border-brutal-black dark:border-brutal-white hover:border-brutal-accent dark:hover:border-brutal-accent transition-colors"
>
  <!-- Video Thumbnail -->
  <div class="relative aspect-video bg-brutal-black overflow-hidden">
    <img
      src={thumbnail}
      alt={title}
      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
      loading="lazy"
    />
    <div class="absolute inset-0 flex items-center justify-center">
      <div class="w-12 h-12 bg-brutal-accent flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
        <svg class="w-5 h-5 text-brutal-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
    </div>
    {duration && (
      <div class="absolute bottom-2 right-2 bg-brutal-black text-brutal-white text-xs font-bold px-2 py-1">
        {duration}
      </div>
    )}
  </div>

  <!-- Video Info -->
  <div class="p-5 bg-brutal-white dark:bg-brutal-black">
    <h3 class="font-bold text-brutal-black dark:text-brutal-white mb-3 line-clamp-2 group-hover:text-brutal-accent transition-colors text-sm uppercase tracking-wide">
      {title}
    </h3>
    <div class="flex items-center text-xs font-semibold uppercase tracking-widest text-brutal-black/60 dark:text-brutal-white/60 gap-3 flex-nowrap">
      <div class="flex items-center gap-1 whitespace-nowrap">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
        </svg>
        {views}
      </div>
      <span class="text-brutal-accent flex-shrink-0">&bull;</span>
      <div class="flex items-center gap-1 whitespace-nowrap">
        <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path>
        </svg>
        {likes}
      </div>
      <span class="text-brutal-accent flex-shrink-0">&bull;</span>
      <span class="whitespace-nowrap">{timeAgo}</span>
    </div>
  </div>
</button>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
