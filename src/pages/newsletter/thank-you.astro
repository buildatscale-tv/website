---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Thank You — BuildAtScale Newsletter"
  description="Thank you for subscribing to the BuildAtScale newsletter."
>
  <Header />
  <main class="min-h-[calc(100vh-4rem-12rem)] bg-blue-50 dark:bg-slate-800 flex items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="max-w-xl w-full text-center">
      <div class="bg-white dark:bg-slate-700/50 backdrop-blur-sm rounded-lg p-8 sm:p-12 shadow-lg dark:shadow-slate-700/50 border border-gray-200 dark:border-slate-600">
        <div class="mb-6">
          <div class="mx-auto w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center">
            <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>

        <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100 mb-4">
          You're Subscribed!
        </h1>

        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
          Thanks for joining the BuildAtScale newsletter. You'll be the first to know about new content on AI orchestration, development workflows, and the latest experiments.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/"
            class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-medium transition-colors text-center"
          >
            Back to Home
          </a>
          <a
            href="https://youtube.com/@buildatscale?sub_confirmation=1"
            target="_blank"
            rel="noopener"
            class="w-full sm:w-auto bg-red-600 hover:bg-red-700 text-white px-8 py-3 rounded-lg font-medium transition-colors flex items-center justify-center space-x-2"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>Subscribe on YouTube</span>
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
