---
const stats = [
  { value: '2,400+', label: 'Engineers Enrolled' },
  { value: '$180K', label: 'Avg. Salary Increase' },
  { value: '94%', label: 'Job Placement Rate' },
  { value: '12', label: 'Week Intensive' },
];
---

<section class="relative py-12 border-y border-white/5">
  <div class="absolute inset-0 bg-gradient-to-r from-cyber-900/20 via-transparent to-neon-900/20"/>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      {stats.map(stat => (
        <div class="text-center">
          <div class="text-3xl md:text-4xl font-bold text-white mb-1">{stat.value}</div>
          <div class="text-sm text-dark-400">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
