---
---

<section id="instructor" class="relative py-24 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-dark-950 via-dark-900 to-dark-950"/>
  
  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="order-2 lg:order-1">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neon-500/10 border border-neon-500/20 text-neon-400 text-sm font-medium mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-neon-400 animate-pulse"/>
          Your Instructor
        </div>
        
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
          Learn from someone<br/>
          <span class="text-neon-400">who's built it</span>
        </h2>
        
        <div class="space-y-6 text-dark-300 leading-relaxed">
          <p>
            <strong class="text-white">Dr. Elena Vasquez</strong> led the AI Platform team at Google DeepMind, 
            where she architected training infrastructure for models with 1T+ parameters. Before that, 
            she spent four years at OpenAI working on RLHF and agentic systems.
          </p>
          <p>
            She has shipped AI products serving 50M+ daily users. Her research on efficient fine-tuning 
            has been cited 3,400+ times. Now she is teaching the exact methods she used to build 
            production AI at the world is most advanced labs.
          </p>
        </div>
        
        <div class="grid grid-cols-2 gap-4 mt-8">
          <div class="glass rounded-xl p-4 border border-white/5">
            <div class="text-2xl font-bold text-white mb-1">12+</div>
            <div class="text-sm text-dark-400">Years in AI/ML</div>
          </div>
          <div class="glass rounded-xl p-4 border border-white/5">
            <div class="text-2xl font-bold text-white mb-1">50M+</div>
            <div class="text-sm text-dark-400">Daily Users Served</div>
          </div>
          <div class="glass rounded-xl p-4 border border-white/5">
            <div class="text-2xl font-bold text-white mb-1">3,400+</div>
            <div class="text-sm text-dark-400">Research Citations</div>
          </div>
          <div class="glass rounded-xl p-4 border border-white/5">
            <div class="text-2xl font-bold text-white mb-1">DeepMind</div>
            <div class="text-sm text-dark-400">Former Lead Engineer</div>
          </div>
        </div>
        
        <div class="flex items-center gap-4 mt-8">
          <a href="#enroll" class="px-6 py-3 rounded-full bg-gradient-to-r from-neon-600 to-neon-500 text-white font-semibold hover:from-neon-500 hover:to-neon-400 transition-all shadow-lg shadow-neon-500/20">
            Learn from Elena
          </a>
          <a href="#" class="text-dark-300 hover:text-white transition-colors flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            LinkedIn Profile
          </a>
        </div>
      </div>
      
      <div class="order-1 lg:order-2 relative">
        <div class="absolute inset-0 bg-gradient-to-tr from-neon-500/20 to-cyber-500/20 rounded-3xl blur-2xl"/>
        <div class="relative glass rounded-3xl p-8 border border-white/10">
          <div class="aspect-square rounded-2xl bg-gradient-to-br from-dark-800 to-dark-900 flex items-center justify-center mb-6 overflow-hidden">
            <div class="text-8xl font-bold bg-gradient-to-br from-neon-400 to-cyber-400 bg-clip-text text-transparent">
              EV
            </div>
          </div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"/>
            <span class="text-sm text-dark-300">Available for 1:1 mentorship</span>
          </div>
          <div class="space-y-3">
            <div class="flex items-center gap-3 text-sm text-dark-300">
              <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Live office hours every Tuesday
            </div>
            <div class="flex items-center gap-3 text-sm text-dark-300">
              <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Code review within 24 hours
            </div>
            <div class="flex items-center gap-3 text-sm text-dark-300">
              <svg class="w-5 h-5 text-neon-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              Private Discord community access
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
