---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI Mastery — The Ultimate AI Engineering Course">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="hero-badge-dot"></span>
            Enrollments Open — Next Cohort Starts July 1
          </div>
          <h1 class="hero-title">
            Build <span class="gradient-text">Production AI</span><br />
            That Actually Delivers
          </h1>
          <p class="hero-description">
            From prompt engineering to deploying multi-agent systems at scale.
            AI Mastery is the immersive, project-based program that takes you
            from capable developer to AI architect in 12 weeks.
          </p>
          <div class="hero-actions">
            <a href="#pricing" class="btn btn-primary btn-large">
              Enroll Now — Early Access $499
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="/experiments/ai-course/curriculum" class="btn btn-secondary btn-large">
              View Curriculum
            </a>
          </div>
          <div class="hero-metrics">
            <div class="metric">
              <span class="metric-value gradient-text">12</span>
              <span class="metric-label">Weeks</span>
            </div>
            <div class="metric-divider"></div>
            <div class="metric">
              <span class="metric-value gradient-text">40+</span>
              <span class="metric-label">Projects</span>
            </div>
            <div class="metric-divider"></div>
            <div class="metric">
              <span class="metric-value gradient-text">10K+</span>
              <span class="metric-label">Students</span>
            </div>
            <div class="metric-divider"></div>
            <div class="metric">
              <span class="metric-value gradient-text">4.9★</span>
              <span class="metric-label">Rating</span>
            </div>
          </div>
        </div>
        <div class="hero-visual">
          <div class="code-window">
            <div class="code-header">
              <span class="code-dot red"></span>
              <span class="code-dot yellow"></span>
              <span class="code-dot green"></span>
              <span class="code-title">agent.py</span>
            </div>
            <div class="code-body">
              <pre><span class="code-keyword">from</span> <span class="code-type">ai_core</span> <span class="code-keyword">import</span> Agent, Pipeline

<span class="code-comment"># Deploy a reasoning agent</span>
agent = Agent(
    model=<span class="code-string">"gpt-5"</span>,
    tools=[WebSearch, CodeGen],
    memory=<span class="code-string">"persistent"</span>,
)

pipeline = Pipeline(agent)
result = pipeline.run(
    <span class="code-string">"Build a real-time API"</span>
)
<span class="code-builtin">print</span>(result)</pre>
            </div>
          </div>
          <div class="floating-card card-1">
            <span class="card-icon">🧠</span>
            <div>
              <strong>LLM Orchestration</strong>
              <small>Module 3</small>
            </div>
          </div>
          <div class="floating-card card-2">
            <span class="card-icon">⚡</span>
            <div>
              <strong>Agent Systems</strong>
              <small>Module 6</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Bar -->
  <section class="trust-bar">
    <div class="container">
      <p class="trust-label">Trusted by engineering teams at</p>
      <div class="trust-logos">
        <span class="trust-logo">Vercel</span>
        <span class="trust-logo">Stripe</span>
        <span class="trust-logo">Notion</span>
        <span class="trust-logo">Linear</span>
        <span class="trust-logo">Replit</span>
        <span class="trust-logo">Supabase</span>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="section" id="problem">
    <div class="container">
      <div class="problem-grid">
        <div class="problem-card reveal">
          <span class="problem-icon">😰</span>
          <h3>Too much AI hype, not enough signal</h3>
          <p>Every day there's a new model, framework, or "revolutionary" tool. Most courses teach you buzzwords, not build skills.</p>
        </div>
        <div class="problem-card reveal">
          <span class="problem-icon">🧩</span>
          <h3>Fragmented learning</h3>
          <p>You stitch together YouTube tutorials, docs, and blog posts—but never see how pieces fit into a production system.</p>
        </div>
        <div class="problem-card reveal">
          <span class="problem-icon">🚫</span>
          <h3>"Toy" projects don't ship</h3>
          <p>Chatbot tutorials are everywhere. Real-world AI requires retrieval pipelines, guardrails, observability, and deployment know-how.</p>
        </div>
      </div>
      <div class="problem-cta reveal">
        <p>AI Mastery bridges that gap — <strong>systematically.</strong></p>
      </div>
    </div>
  </section>

  <!-- Curriculum Preview -->
  <section class="section" id="curriculum">
    <div class="container">
      <div class="section-label reveal">Curriculum</div>
      <h2 class="section-title reveal">From Fundamentals to<br /><span class="gradient-text">Production Systems</span></h2>
      <p class="section-subtitle reveal">12 intensive modules, 40+ hands-on projects, and a capstone that becomes your portfolio centerpiece.</p>

      <div class="modules-grid">
        <div class="module-card reveal">
          <div class="module-number">01</div>
          <h3 class="module-title">AI Foundations & Prompt Engineering</h3>
          <p class="module-desc">Tokenization, embeddings, attention mechanisms. Master prompt chains, few-shot, and structured outputs.</p>
          <div class="module-tags">
            <span class="tag">LLMs</span>
            <span class="tag">Prompts</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">02</div>
          <h3 class="module-title">Retrieval-Augmented Generation (RAG)</h3>
          <p class="module-desc">Vector databases, chunking strategies, hybrid search, and re-ranking for accurate knowledge retrieval.</p>
          <div class="module-tags">
            <span class="tag">RAG</span>
            <span class="tag">Vector DB</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">03</div>
          <h3 class="module-title">LLM Orchestration & Tool Use</h3>
          <p class="module-desc">Function calling, tool chaining, parallel execution, and structured outputs with Pydantic.</p>
          <div class="module-tags">
            <span class="tag">Orchestration</span>
            <span class="tag">APIs</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">04</div>
          <h3 class="module-title">Evaluation & Observability</h3>
          <p class="module-desc">LLM-as-judge, dataset curation, tracing, token tracking, and regression testing for AI pipelines.</p>
          <div class="module-tags">
            <span class="tag">Evals</span>
            <span class="tag">Monitoring</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">05</div>
          <h3 class="module-title">Multi-Agent Architectures</h3>
          <p class="module-desc">Build swarms of specialized agents with delegation, consensus, and hierarchical planning.</p>
          <div class="module-tags">
            <span class="tag">Agents</span>
            <span class="tag">Swarm</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">06</div>
          <h3 class="module-title">Fine-Tuning & Custom Models</h3>
          <p class="module-desc">LoRA, QLoRA, RLHF, and dataset engineering. Deploy custom adapters at scale.</p>
          <div class="module-tags">
            <span class="tag">Fine-Tuning</span>
            <span class="tag">LoRA</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">07</div>
          <h3 class="module-title">AI Safety & Guardrails</h3>
          <p class="module-desc">Content filters, rate limiting, prompt injection defense, and red-teaming methodology.</p>
          <div class="module-tags">
            <span class="tag">Safety</span>
            <span class="tag">Guardrails</span>
          </div>
        </div>
        <div class="module-card reveal">
          <div class="module-number">08</div>
          <h3 class="module-title">Deployment & Infrastructure</h3>
          <p class="module-desc">Containerization, GPU serving, serverless AI, edge inference, and CI/CD for ML pipelines.</p>
          <div class="module-tags">
            <span class="tag">DevOps</span>
            <span class="tag">Serving</span>
          </div>
        </div>
      </div>
      <div class="curriculum-cta reveal">
        <a href="/experiments/ai-course/curriculum" class="btn btn-secondary">
          Explore Full Curriculum
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Instructor Section -->
  <section class="section instructor-section" id="instructor">
    <div class="container">
      <div class="instructor-grid">
        <div class="instructor-photo reveal">
          <div class="photo-frame">
            <div class="photo-placeholder">
              <span class="photo-initials">DR</span>
            </div>
            <div class="photo-glow"></div>
          </div>
          <div class="instructor-stats">
            <div class="stat-row">
              <span class="stat-label">Experience</span>
              <span class="stat-value">15+ years</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Students Taught</span>
              <span class="stat-value">10,000+</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Companies</span>
              <span class="stat-value">Google, OpenAI, Meta</span>
            </div>
          </div>
        </div>
        <div class="instructor-content reveal">
          <div class="section-label">Your Instructor</div>
          <h2 class="section-title">Dr. Sarah Chen<br /><span class="gradient-text">AI Architect & Educator</span></h2>
          <p class="instructor-bio">
            Former Staff Engineer at Google AI and founding engineer at a YC-backed AI startup. Sarah has spent the last
            decade building production ML systems serving billions of requests. She's taught AI engineering at
            Stanford Continuing Studies and authored 3 published papers on LLM orchestration.
          </p>
          <div class="instructor-highlights">
            <div class="highlight">
              <span class="highlight-icon">📖</span>
              <span>Authored "LLMs in Production" (O'Reilly)</span>
            </div>
            <div class="highlight">
              <span class="highlight-icon">🎤</span>
              <span>Keynote speaker at NeurIPS, PyCon, AI Engineer Summit</span>
            </div>
            <div class="highlight">
              <span class="highlight-icon">🏆</span>
              <span>Built AI systems used by 100M+ users</span>
            </div>
          </div>
          <a href="/experiments/ai-course/instructor" class="btn btn-secondary">
            Read Full Bio
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Outcomes Section -->
  <section class="section" id="outcomes">
    <div class="container">
      <div class="section-label reveal">Student Outcomes</div>
      <h2 class="section-title reveal">Real Results From<br /><span class="gradient-text">Real Developers</span></h2>

      <div class="outcomes-grid">
        <div class="outcome-card reveal">
          <div class="outcome-header">
            <div class="outcome-avatar">JM</div>
            <div>
              <strong>Jasmine M.</strong>
              <span class="outcome-role">Senior FE → AI Engineer @ Stripe</span>
            </div>
          </div>
          <p class="outcome-quote">"I went from building React components to designing multi-agent systems. The RAG module alone was worth the price. My salary increased 60% within 4 months of completing the course."</p>
          <div class="outcome-result">
            <span class="outcome-result-icon">📈</span>
            <span>60% salary increase</span>
          </div>
        </div>
        <div class="outcome-card reveal">
          <div class="outcome-header">
            <div class="outcome-avatar">AK</div>
            <div>
              <strong>Alex K.</strong>
              <span class="outcome-role">Backend Dev → ML Engineer @ Anthropic</span>
            </div>
          </div>
          <p class="outcome-quote">"The capstone project—a production RAG pipeline with monitoring—was the centerpiece of my interview. The team at Anthropic told me it was the strongest portfolio piece they'd seen."</p>
          <div class="outcome-result">
            <span class="outcome-result-icon">💼</span>
            <span>Landing dream job</span>
          </div>
        </div>
        <div class="outcome-card reveal">
          <div class="outcome-header">
            <div class="outcome-avatar">RT</div>
            <div>
              <strong>Raj T.</strong>
              <span class="outcome-role">Independent Consultant</span>
            </div>
          </div>
          <p class="outcome-quote">"I started my own AI consultancy after graduating. Within 3 months I had 5 clients and was billing $20k/month building custom AI solutions for SMBs. Best career investment I've ever made."</p>
          <div class="outcome-result">
            <span class="outcome-result-icon">🚀</span>
            <span>Launched $20k/mo consulting</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing / CTA Section -->
  <section class="section pricing-section" id="pricing">
    <div class="container">
      <div class="section-label reveal">Enroll Now</div>
      <h2 class="section-title reveal">Invest in Your<br /><span class="gradient-text">AI Future</span></h2>

      <div class="pricing-grid">
        <div class="pricing-card reveal">
          <div class="pricing-badge">Most Popular</div>
          <h3 class="pricing-name">Early Access</h3>
          <div class="pricing-price">
            <span class="price-amount">$499</span>
            <span class="price-original">$1,499</span>
          </div>
          <p class="pricing-desc">Full course access + community + certificate. Lock in the lowest price forever.</p>
          <ul class="pricing-features">
            <li>All 8 modules + 40 projects</li>
            <li>Capstone portfolio project</li>
            <li>Private community & study groups</li>
            <li>Certificate of completion</li>
            <li>Lifetime access & updates</li>
            <li>Office hours with instructors</li>
          </ul>
          <a href="#" class="btn btn-primary pricing-btn">
            Enroll Now — $499
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="pricing-card pricing-featured reveal">
          <div class="pricing-badge">Best Value</div>
          <h3 class="pricing-name">Pro Access</h3>
          <div class="pricing-price">
            <span class="price-amount">$799</span>
            <span class="price-original">$2,499</span>
          </div>
          <p class="pricing-desc">Everything in Early Access plus 1:1 mentoring, resume review, and job placement assistance.</p>
          <ul class="pricing-features">
            <li>Everything in Early Access</li>
            <li>4x 1:1 mentoring sessions</li>
            <li>Resume & portfolio review</li>
            <li>Job placement assistance</li>
            <li>API credits ($200 value)</li>
            <li>Early access to new modules</li>
          </ul>
          <a href="#" class="btn btn-primary pricing-btn">
            Enroll Now — $799
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="pricing-card reveal">
          <div class="pricing-badge">Team</div>
          <h3 class="pricing-name">Enterprise</h3>
          <div class="pricing-price">
            <span class="price-amount">Contact</span>
          </div>
          <p class="pricing-desc">For teams of 5+ with custom curriculum, dedicated support, and compliance packages.</p>
          <ul class="pricing-features">
            <li>Everything in Pro Access</li>
            <li>Custom cohort scheduling</li>
            <li>Dedicated success manager</li>
            <li>SOC 2 compliance ready</li>
            <li>Custom integrations</li>
            <li>Volume pricing</li>
          </ul>
          <a href="#" class="btn btn-secondary pricing-btn">
            Contact Sales
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-label reveal">FAQ</div>
      <h2 class="section-title reveal">Questions?<br /><span class="gradient-text">We've Got Answers</span></h2>

      <div class="faq-grid">
        <details class="faq-item reveal" open>
          <summary>Who is this course for?</summary>
          <p>Experienced developers (2+ years) who want to specialize in AI engineering. You should be comfortable with Python and basic web development. No prior ML experience required.</p>
        </details>
        <details class="faq-item reveal">
          <summary>What's the time commitment?</summary>
          <p>The course is designed for 10-15 hours per week over 12 weeks. Each module includes ~4 hours of video content, 3-5 hands-on projects, and community discussions. Self-paced options are also available.</p>
        </details>
        <details class="faq-item reveal">
          <summary>Do I need a powerful GPU?</summary>
          <p>No. All exercises use cloud-based runtimes with GPU access included. You just need a modern browser and a stable internet connection.</p>
        </details>
        <details class="faq-item reveal">
          <summary>What if I'm not satisfied?</summary>
          <p>We offer a 14-day full refund policy. If the course isn't delivering value, email us and we'll refund every cent — no questions asked.</p>
        </details>
        <details class="faq-item reveal">
          <summary>Is there a certificate?</summary>
          <p>Yes. Graduates receive a verified certificate co-signed by Dr. Sarah Chen and AI Mastery. Pro Access graduates also get a LinkedIn endorsement.</p>
        </details>
        <details class="faq-item reveal">
          <summary>Will the content stay up to date?</summary>
          <p>Absolutely. The AI landscape moves fast. All enrolled students get lifetime access to updates, new modules, and evolving curriculum content for free.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section final-cta">
    <div class="container">
      <div class="cta-box reveal">
        <div class="cta-glow"></div>
        <h2 class="cta-title">Your AI Engineering Career<br />
          <span class="gradient-text">Starts This July</span></h2>
        <p class="cta-desc">Join 10,000+ developers who've transformed their careers. Early Access pricing ends June 1.</p>
        <div class="cta-actions">
          <a href="#pricing" class="btn btn-primary btn-large">
            Enroll Now — $499
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <p class="cta-risk">⚡ No risk. 14-day money-back guarantee.</p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  /* === HERO === */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.2);
    padding: 8px 16px;
    border-radius: 50px;
    font-size: 0.85rem;
    color: var(--accent-purple);
    margin-bottom: 24px;
  }

  .hero-badge-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    font-size: clamp(2.8rem, 5.5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .hero-metrics {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
  }

  .metric {
    display: flex;
    flex-direction: column;
  }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .metric-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-divider {
    width: 1px;
    height: 36px;
    background: var(--border-color);
  }

  /* Hero visual - code window */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .code-window {
    width: 100%;
    max-width: 460px;
    background: rgba(15, 15, 40, 0.8);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    backdrop-filter: blur(20px);
    box-shadow: 0 20px 80px rgba(0, 0, 0, 0.5);
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-color);
  }

  .code-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .code-dot.red { background: #ff5f56; }
  .code-dot.yellow { background: #ffbd2e; }
  .code-dot.green { background: #27c93f; }

  .code-title {
    margin-left: 8px;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .code-body {
    padding: 20px;
  }

  .code-body pre {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--text-secondary);
    white-space: pre-wrap;
  }

  .code-keyword { color: #c678dd; }
  .code-type { color: #e5c07b; }
  .code-string { color: #98c379; }
  .code-comment { color: #5c6370; font-style: italic; }
  .code-builtin { color: #61afef; }

  .floating-card {
    position: absolute;
    background: rgba(20, 20, 50, 0.9);
    backdrop-filter: blur(12px);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    animation: float 6s ease-in-out infinite;
  }

  .floating-card strong {
    display: block;
    font-size: 0.8rem;
    color: var(--text-primary);
  }

  .floating-card small {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .card-icon {
    font-size: 1.4rem;
  }

  .card-1 {
