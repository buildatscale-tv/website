---
export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'An AI developer course that transforms how you build software. Start the next cohort.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400;1,600&family=Source+Serif+4:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --pastel-rose: #f5e6e8;
    --pastel-lavender: #e8e4f0;
    --pastel-blue: #e0ecf4;
    --pastel-mint: #dff0e8;
    --pastel-cream: #faf6ee;
    --pastel-peach: #fce8db;

    --ink: #1a1a2e;
    --ink-light: #3d3d56;
    --ink-muted: #6b6b80;
    --ink-faint: #9a9aad;

    --accent-plum: #6b3fa0;
    --accent-plum-light: #8b5fbf;
    --accent-terra: #c4604a;
    --accent-terra-light: #d8856f;

    --serif: 'Playfair Display', 'Georgia', serif;
    --body-serif: 'Source Serif 4', 'Georgia', serif;
    --mono: 'JetBrains Mono', 'Fira Code', monospace;

    --max-width: 720px;
    --max-width-wide: 1080px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 18px;
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--body-serif);
    color: var(--ink);
    background: #fdfcfb;
    line-height: 1.72;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--pastel-lavender);
    color: var(--ink);
  }

  a {
    color: var(--accent-plum);
    text-decoration: none;
    border-bottom: 1px solid var(--pastel-lavender);
    transition: border-color 0.2s ease;
  }

  a:hover {
    border-bottom-color: var(--accent-plum);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container--wide {
    max-width: var(--max-width-wide);
  }

  @media (max-width: 768px) {
    html {
      font-size: 16px;
    }
  }
</style>