---
const lines = [
  { prefix: '$', text: ' ai-course enroll --track=full-stack', delay: 300 },
  { prefix: '>', text: ' Initializing learning environment...', delay: 800 },
  { prefix: '>', text: ' Loading curriculum modules: 12 found', delay: 500 },
  { prefix: '>', text: ' [OK] Foundation: LLM Architecture & Prompt Engineering', delay: 400 },
  { prefix: '>', text: ' [OK] Models: Fine-tuning, RAG, Multi-modal', delay: 400 },
  { prefix: '>', text: ' [OK] Deploy: Production APIs, Scaling, Monitoring', delay: 400 },
  { prefix: '>', text: ' Connecting to mentor network...', delay: 600 },
  { prefix: '$', text: ' status --transformation=90-days', delay: 800 },
  { prefix: '>', text: ' STATUS: READY. Your AI journey begins now.', delay: 500 },
];
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background effects -->
  <div class="absolute inset-0 bg-cinematic-950">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_rgba(0,240,255,0.08)_0%,_transparent_70%)]"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-neon-blue/40 to-transparent"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-full h-px bg-gradient-to-r from-transparent via-neon-blue/20 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto px-6 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text -->
      <div class="space-y-8">
        <div class="space-y-4">
          <p class="font-mono text-neon-blue text-sm tracking-widest uppercase">The AI Developer Accelerator</p>
          <h1 class="text-5xl md:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.1]">
            BECOME<br/>
            <span class="neon-text">AI-FLUENT</span><br/>
            IN 90 DAYS
          </h1>
        </div>
        <p class="text-lg md:text-xl text-slate-400 max-w-lg leading-relaxed">
          From zero to shipping production-grade AI systems. No fluff. No theory dumps. Just hands-on mastery of the stack that powers the future.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#enroll" class="group relative inline-flex items-center gap-2 px-8 py-4 bg-neon-blue text-cinematic-950 font-bold uppercase tracking-wider text-sm hover:bg-white transition-colors duration-300">
            <span>Start Your Transformation</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#curriculum" class="inline-flex items-center gap-2 px-8 py-4 border border-slate-700 text-slate-300 font-medium uppercase tracking-wider text-sm hover:border-neon-blue hover:text-neon-blue transition-colors duration-300">
            View Curriculum
          </a>
        </div>
        <div class="flex items-center gap-6 text-xs font-mono text-slate-500">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
            2,847 developers enrolled
          </span>
          <span>Next cohort: June 2</span>
        </div>
      </div>

      <!-- Right: Terminal -->
      <div class="relative">
        <div class="absolute -inset-1 bg-gradient-to-r from-neon-blue/20 to-purple-500/20 rounded-lg blur-xl opacity-50"></div>
        <div class="relative bg-cinematic-900 rounded-lg border border-slate-800 overflow-hidden">
          <!-- Terminal header -->
          <div class="flex items-center gap-2 px-4 py-3 bg-cinematic-800 border-b border-slate-800">
            <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
            <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
            <span class="ml-2 text-xs font-mono text-slate-500">ai-course-cli</span>
          </div>
          <!-- Terminal body -->
          <div class="p-6 font-mono text-sm min-h-[320px] space-y-1" id="terminal-body">
            {lines.map((line, i) => (
              <div class="terminal-line opacity-0" data-delay={line.delay} data-index={i}>
                <span class={line.prefix === '$' ? 'text-green-400' : 'text-slate-600'}>{line.prefix}</span>
                <span class="text-slate-300">{line.text}</span>
              </div>
            ))}
            <div class="terminal-line opacity-0 mt-4" data-index={lines.length}>
              <span class="text-neon-blue animate-pulse">_</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const terminalLines = document.querySelectorAll('.terminal-line');
  let currentLine = 0;

  function typeLine() {
    if (currentLine >= terminalLines.length) {
      // Restart after a pause
      setTimeout(() => {
        terminalLines.forEach(line => {
          line.classList.remove('opacity-100');
          line.classList.add('opacity-0');
        });
        currentLine = 0;
        typeLine();
      }, 5000);
      return;
    }

    const line = terminalLines[currentLine];
    const delay = parseInt(line.dataset.delay || '100');
    
    setTimeout(() => {
      line.classList.remove('opacity-0');
      line.classList.add('opacity-100');
      currentLine++;
      typeLine();
    }, delay);
  }

  // Start animation when visible
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        typeLine();
        observer.disconnect();
      }
    });
  }, { threshold: 0.3 });

  const terminalBody = document.getElementById('terminal-body');
  if (terminalBody) observer.observe(terminalBody);
</script>
