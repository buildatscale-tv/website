<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AI Developer Course — Become AI-fluent in 90 Days</title>
  <meta name="description" content="Master AI development in 90 days. From foundations to production deployment. Join the transformation." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="bg-cinematic-950 text-slate-200 antialiased">
  <slot />
  <style is:global>
    html {
      scroll-behavior: smooth;
    }
    body {
      font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .font-mono {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    ::selection {
      background: rgba(0, 240, 255, 0.3);
      color: white;
    }
    .neon-border {
      border: 1px solid rgba(0, 240, 255, 0.3);
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.1);
    }
    .neon-text {
      color: #00f0ff;
      text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
    }
    .neon-text-purple {
      color: #a855f7;
      text-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
    }
    .gradient-line {
      background: linear-gradient(90deg, transparent, #00f0ff, transparent);
    }
  </style>
