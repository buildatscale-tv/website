---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <nav class="fixed top-0 left-0 right-0 z-50 px-6 py-5 transition-all duration-500" id="navbar">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <span class="w-10 h-10 border-2 border-brand-500 rounded-full flex items-center justify-center text-brand-500 font-display text-lg font-bold transition-colors group-hover:bg-brand-500 group-hover:text-cream">H</span>
        <div class="leading-tight">
          <span class="block text-sm font-display font-semibold tracking-widest uppercase text-white/90">Hartwood</span>
          <span class="block text-[10px] tracking-[0.3em] uppercase text-white/60">Custom Cabinets</span>
        </div>
      </a>
      <div class="hidden md:flex items-center gap-10">
        <a href="#portfolio" class="text-sm text-white/80 hover:text-brand-300 transition-colors tracking-wide uppercase font-medium">Portfolio</a>
        <a href="#services" class="text-sm text-white/80 hover:text-brand-300 transition-colors tracking-wide uppercase font-medium">Services</a>
        <a href="#testimonials" class="text-sm text-white/80 hover:text-brand-300 transition-colors tracking-wide uppercase font-medium">Testimonials</a>
        <a href="#contact" class="px-6 py-2.5 bg-brand-500 hover:bg-brand-600 text-white text-sm tracking-wide uppercase font-medium transition-all rounded-sm">Get a Quote</a>
      </div>
    </div>
  </nav>

  <section class="relative h-screen min-h-[700px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/hero-kitchen.jpg" alt="Handcrafted walnut kitchen" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-charcoal/80 via-charcoal/50 to-charcoal/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/40 via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <div class="max-w-3xl">
        <div class="mb-6 opacity-0 animate-fade-in" style="animation-delay: 0.2s">
          <span class="inline-block px-4 py-2 border border-brand-500/40 text-brand-300 text-xs tracking-[0.25em] uppercase font-display">Est. 1987</span>
        </div>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold text-white leading-[1.08] mb-6 opacity-0 animate-fade-in" style="animation-delay: 0.4s">
          Cabinetry<br />
          <span class="text-brand-300 italic font-normal">Built to Last</span>
        </h1>
        <p class="text-lg md:text-xl text-white/70 max-w-xl leading-relaxed mb-10 opacity-0 animate-fade-in" style="animation-delay: 0.6s">
          Hartwood Custom Cabinets brings generations of woodworking mastery to every project. From intimate kitchen remodels to sprawling library installations — each piece is handcrafted with uncompromising attention to detail.
        </p>
        <div class="flex flex-wrap gap-4 opacity-0 animate-fade-in" style="animation-delay: 0.8s">
          <a href="#portfolio" class="px-8 py-3.5 bg-brand-500 hover:bg-brand-600 text-white font-display text-sm tracking-widest uppercase transition-all rounded-sm">View Our Work</a>
          <a href="#contact" class="px-8 py-3.5 border-2 border-white/30 hover:border-white/60 text-white font-display text-sm tracking-widest uppercase transition-all rounded-sm">Request a Consultation</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
    </div>
  </section>

  <section class="relative py-28 md:py-36 px-6 bg-cream">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 md:gap-24 items-center">
        <div class="relative">
          <div class="aspect-[4/5] overflow-hidden rounded-sm">
            <img src="/images/workshop.jpg" alt="Hartwood workshop" class="w-full h-full object-cover" onerror="this.style.display='none'" />
          </div>
          <div class="absolute -bottom-6 -right-6 bg-white p-8 shadow-2xl hidden md:block rounded-sm">
            <span class="block text-4xl font-display font-bold text-brand-600">38+</span>
            <span class="text-sm text-charcoal/60 tracking-wide uppercase">Years of Mastery</span>
          </div>
        </div>
        <div>
          <span class="text-brand-500 text-xs tracking-[0.3em] uppercase font-display font-semibold">Our Craft</span>
          <h2 class="font-display text-4xl md:text-5xl text-charcoal leading-[1.1] mt-4 mb-6">
            Where <span class="italic text-brand-500">Tradition</span><br />Meets Precision
          </h2>
          <div class="w-16 h-0.5 bg-brand-400 mb-8"></div>
          <p class="text-charcoal/70 leading-relaxed text-lg mb-6">
            At Hartwood, we believe a cabinet should feel as good as it looks. Every dovetail joint is cut by hand. Every drawer is balanced to glide silently. Every finish is rubbed to a depth that mass production simply cannot match.
          </p>
          <p class="text-charcoal/60 leading-relaxed">
            Founded by master craftsman Thomas Hartwood in 1987, our shop has grown from a one-man operation into a team of eight dedicated artisans — yet we've never lost the conviction that the best tool in any workshop is a steady hand and an exacting eye.
          </p>
          <div class="grid grid-cols-3 gap-8 mt-12 pt-12 border-t border-charcoal/10">
            <div>
              <span class="block text-3xl font-display font-bold text-charcoal">500+</span>
              <span class="text-xs text-charcoal/50 tracking-wide uppercase">Projects Built</span>
            </div>
            <div>
              <span class="block text-3xl font-display font-bold text-charcoal">8</span>
              <span class="text-xs text-charcoal/50 tracking-wide uppercase">Master Artisans</span>
            </div>
            <div>
              <span class="block text-3xl font-display font-bold text-charcoal">100%</span>
              <span class="text-xs text-charcoal/50 tracking-wide uppercase">Custom Design</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="portfolio" class="relative py-28 md:py-36 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-brand-500 text-xs tracking-[0.3em] uppercase font-display font-semibold">Portfolio</span>
        <h2 class="font-display text-4xl md:text-5xl text-charcoal leading-[1.1] mt-4 mb-4">
          Our Recent Work
        </h2>
        <div class="w-16 h-0.5 bg-brand-400 mx-auto mb-6"></div>
        <p class="text-charcoal/60 max-w-xl mx-auto">Every project tells a story. Browse a selection of our recent commissions.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="group relative overflow-hidden rounded-sm aspect-[4/5]">
          <img src="/images/portfolio-cabinets-1.jpg" alt="Custom kitchen cabinetry with cherry wood finish" class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-charcoal/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
            <div class="absolute bottom-0 left-0 right-0 p-8">
              <span class="text-brand-300 text-xs tracking-[0.2em] uppercase">Kitchen</span>
              <h3 class="text-white font-display text-xl mt-1">Cherrywood Kitchen</h3>
              <p class="text-white/60 text-sm mt-1">Full custom cabinetry with hand-cut dovetail drawers</p>
            </div>
          </div>
        </div>
        <div class="group relative overflow-hidden rounded-sm aspect-[4/5]">
          <img src="/images/portfolio-cabinets-2.jpg" alt="Custom built-in library with white oak shelving" class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-charcoal/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
            <div class="absolute bottom-0 left-0 right-0 p-8">
              <span class="text-brand-300 text-xs tracking-[0.2em] uppercase">Built-ins</span>
              <h3 class="text-white font-display text-xl mt-1">Oak Library</h3>
              <p class="text-white/60 text-sm mt-1">Floor-to-ceiling built-in with integrated lighting</p>
            </div>
          </div>
        </div>
        <div class="group relative overflow-hidden rounded-sm aspect-[4/5]">
          <img src="/images/portfolio-bathroom.jpg" alt="Custom walnut bathroom vanity" class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/80 via-charcoal/20 to-transparent opacity-0 group-hover:opacity-100 transition-all duration-500">
            <div class="absolute bottom-0 left-0 right-0 p-8">
              <span class="text-brand-300 text-xs tracking-[0.2em] uppercase">Bathroom</span>
              <h3 class="text-white font-display text-xl mt-1">Walnut Vanity Suite</h3>
              <p class="text-white/60 text-sm mt-1">Dual vanity with marble top and soft-close drawers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="relative py-28 md:py-36 px-6 bg-cream">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <span class="text-brand-500 text-xs tracking-[0.3em] uppercase font-display font-semibold">Services</span>
        <h2 class="font-display text-4xl md:text-5xl text-charcoal leading-[1.1] mt-4 mb-4">
          What We Build
        </h2>
        <div class="w-16 h-0.5 bg-brand-400 mx-auto mb-6"></div>
        <p class="text-charcoal/60 max-w-xl mx-auto">From concept to completion — every service is guided by the same ethos: craft first, always.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-8 rounded-sm shadow-sm hover:shadow-xl transition-all duration-500 group">
          <div class="w-14 h-14 border-2 border-brand-300 rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-500 group-hover:border-brand-500 transition-all duration-500">
            <svg class="w-6 h-6 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal mb-3">Custom Kitchens</h3>
          <p class="text-charcoal/60 text-sm leading-relaxed">Fully bespoke kitchen cabinetry — from traditional inset to modern frameless, with hand-finished interiors and precision millwork.</p>
        </div>
        <div class="bg-white p-8 rounded-sm shadow-sm hover:shadow-xl transition-all duration-500 group">
          <div class="w-14 h-14 border-2 border-brand-300 rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-500 group-hover:border-brand-500 transition-all duration-500">
            <svg class="w-6 h-6 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal mb-3">Built-Ins</h3>
          <p class="text-charcoal/60 text-sm leading-relaxed">Custom entertainment centers, home libraries, window seats, and architectural millwork designed to complement your space perfectly.</p>
        </div>
        <div class="bg-white p-8 rounded-sm shadow-sm hover:shadow-xl transition-all duration-500 group">
          <div class="w-14 h-14 border-2 border-brand-300 rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-500 group-hover:border-brand-500 transition-all duration-500">
            <svg class="w-6 h-6 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal mb-3">Bath Vanities</h3>
          <p class="text-charcoal/60 text-sm leading-relaxed">Luxury bathroom vanities crafted in any wood species, with hand-rubbed oil finishes, integrated sinks, and artisan hardware.</p>
        </div>
        <div class="bg-white p-8 rounded-sm shadow-sm hover:shadow-xl transition-all duration-500 group">
          <div class="w-14 h-14 border-2 border-brand-300 rounded-full flex items-center justify-center mb-6 group-hover:bg-brand-500 group-hover:border-brand-500 transition-all duration-500">
            <svg class="w-6 h-6 text-brand-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          </div>
          <h3 class="font-display text-xl text-charcoal mb-3">Restoration</h3>
          <p class="text-charcoal/60 text-sm leading-relaxed">Breathing new life into heirloom pieces and period cabinetry. Expert restoration, refinishing, and hardware replacement.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="testimonials" class="relative py-28 md:py-36 px-6 bg-charcoal overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-10 left-10 w-64 h-64 border border-brand-500/20 rounded-full"></div>
      <div class="absolute bottom-20 right-20 w-96 h-96 border border-brand-500/20 rounded-full"></div>
    </div>
    <div class="max-w-4xl mx-auto relative z-10">
      <div class="text-center mb-16">
        <span class="text-brand-400 text-xs tracking-[0.3em] uppercase font-display font-semibold">Testimonials</span>
        <h2 class="font-display text-4xl md:text-5xl text-white leading-[1.1] mt-4 mb-4">
          What Our Clients Say
        </h2>
        <div class="w-16 h-0.5 bg-brand-500 mx-auto"></div>
      </div>
      <div class="grid gap-10">
        <div class="bg-white/5 backdrop-blur-sm p-10 md:p-12 rounded-sm border border-white/10">
          <div class="flex items-center gap-1 mb-6">
            {[1,2,3,4,5].map((i) => (
              <svg key={i} class="w-5 h-5 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <blockquote class="font-display text-2xl md:text-3xl text-white/90 leading-[1.4] italic mb-8">
            "Working with Hartwood was a revelation. They didn't just build cabinets — they crafted the heart of our home. Every detail, from the grain-matched doors to the custom drawer organization, speaks to their mastery."
          </blockquote>
          <div>
            <span class="block text-white font-display text-lg">Sarah & Michael Chen</span>
            <span class="text-white/50 text-sm">Kitchen Renovation, Portland</span>
          </div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm p-10 md:p-12 rounded-sm border border-white/10">
          <div class="flex items-center gap-1 mb-6">
            {[1,2,3,4,5].map((i) => (
              <svg key={i} class="w-5 h-5 text-brand-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <blockquote class="font-display text-2xl md:text-3xl text-white/90 leading-[1.4] italic mb-8">
            "Our library is the room guests never want to leave. The oak shelving Hartwood built is both structural sculpture and functional art. They understood our vision and elevated it beyond what we imagined."
          </blockquote>
          <div>
            <span class="block text-white font-display text-lg">James Whitfield</span>
            <span class="text-white/50 text-sm">Library Built-In, Lake Oswego</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="relative py-28 md:py-36 px-6 bg-cream">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-16 md:gap-24">
        <div>
          <span class="text-brand-500 text-xs tracking-[0.3em] uppercase font-display font-semibold">Contact</span>
          <h2 class="font-display text-4xl md:text-5xl text-charcoal leading-[1.1] mt-4 mb-4">
            Let's Build<br />Something <span class="italic text-brand-500">Beautiful</span>
          </h2>
          <div class="w-16 h-0.5 bg-brand-400 mb-8"></div>
          <p class="text-charcoal/70 leading-relaxed mb-10">
            Ready to start your project? Tell us about your vision and we'll schedule a complimentary in-home consultation. No obligation — just good conversation about great design.
          </p>
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <span class="block font-display text-charcoal font-semibold">Phone</span>
                <span class="text-charcoal/60">(503) 555-0187</span>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <span class="block font-display text-charcoal font-semibold">Email</span>
                <span class="text-charcoal/60">craft@hartwoodcabinets.com</span>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-brand-100 rounded-full flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              </div>
              <div>
                <span class="block font-display text-charcoal font-semibold">Workshop</span>
                <span class="text-charcoal/60">742 Timber Lane, Portland, OR 97201</span>
              </div>
            </div>
          </div>
        </div>
        <div>
          <form class="bg-white p-10 md:p-12 rounded-sm shadow-sm" action="#" method="POST">
            <div class="grid md:grid-cols-2 gap-5 mb-5">
              <div>
                <label for="name" class="block text-xs tracking-widest uppercase text-charcoal/60 mb-2 font-medium">Name</label>
                <input type="text" id="name" name="name" required class="w-full px-4 py-3 bg-cream border border-charcoal/10 focus:border-brand-400 focus:ring-1 focus:ring-brand-400 outline-none transition-all text-charcoal rounded-sm" placeholder="Your name" />
              </div>
              <div>
                <label for="email" class="block text-xs tracking-widest uppercase text-charcoal/60 mb-2 font-medium">Email</label>
                <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-cream border border-charcoal/10 focus:border-brand-400 focus:ring-1 focus:ring-brand-400 outline-none transition-all text-charcoal rounded-sm" placeholder="your@email.com" />
              </div>
            </div>
            <div class="mb-5">
              <label for="phone" class="block text-xs tracking-widest uppercase text-charcoal/60 mb-2 font-medium">Phone</label>
              <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 bg-cream border border-charcoal/10 focus:border-brand-400 focus:ring-1 focus:ring-brand-400 outline-none transition-all text-charcoal rounded-sm" placeholder="(503) 555-0000" />
            </div>
            <div class="mb-5">
              <label for="project" class="block text-xs tracking-widest uppercase text-charcoal/60 mb-2 font-medium">Project Type</label>
              <select id="project" name="project" class="w-full px-4 py-3 bg-cream border border-charcoal/10 focus:border-brand-400 focus:ring-1 focus:ring-brand-400 outline-none transition-all text-charcoal rounded-sm">
                <option value="">Select a project type</option>
                <option value="kitchen">Custom Kitchen</option>
                <option value="built-in">Built-In Cabinetry</option>
