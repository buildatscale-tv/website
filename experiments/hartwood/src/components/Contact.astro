---
---

<section id="contact" class="py-24 md:py-32 bg-hartwood-sand/30">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16">
      <div>
        <p class="text-hartwood-brown text-sm font-medium tracking-[0.2em] uppercase mb-4">Get in Touch</p>
        <h2 class="font-display text-4xl md:text-5xl font-semibold text-hartwood-espresso mb-6 leading-tight">
          Let's Create Something <span class="italic font-medium">Extraordinary</span>
        </h2>
        <p class="text-hartwood-walnut leading-relaxed mb-10">
          Ready to transform your space? We'd love to hear about your project. 
          Whether you have a fully formed vision or just the seed of an idea, 
          our team is here to guide you every step of the way.
        </p>
        
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-hartwood-espresso text-hartwood-cream rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-hartwood-espresso">Visit Our Workshop</p>
              <p class="text-hartwood-walnut text-sm">248 Craftsman Lane, Woodbridge, VT 05091</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-hartwood-espresso text-hartwood-cream rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-hartwood-espresso">Email Us</p>
              <p class="text-hartwood-walnut text-sm">hello@hartwoodcabinets.com</p>
            </div>
          </div>
          
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-hartwood-espresso text-hartwood-cream rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="font-medium text-hartwood-espresso">Call Us</p>
              <p class="text-hartwood-walnut text-sm">(802) 555-0147</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-hartwood-cream rounded-2xl p-8 shadow-lg">
        <form class="space-y-6" id="contact-form">
          <div class="grid sm:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-sm font-medium text-hartwood-espresso mb-2">First Name</label>
              <input 
                type="text" 
                id="firstName" 
                name="firstName"
                required
                class="w-full px-4 py-3 rounded-xl border border-hartwood-sand bg-white/50 focus:outline-none focus:ring-2 focus:ring-hartwood-brown/50 focus:border-hartwood-brown transition-all text-hartwood-espresso placeholder-hartwood-taupe"
                placeholder="John"
              />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-hartwood-espresso mb-2">Last Name</label>
              <input 
                type="text" 
                id="lastName" 
                name="lastName"
                required
                class="w-full px-4 py-3 rounded-xl border border-hartwood-sand bg-white/50 focus:outline-none focus:ring-2 focus:ring-hartwood-brown/50 focus:border-hartwood-brown transition-all text-hartwood-espresso placeholder-hartwood-taupe"
                placeholder="Doe"
              />
            </div>
          </div>
          
          <div>
            <label for="email" class="block text-sm font-medium text-hartwood-espresso mb-2">Email Address</label>
            <input 
              type="email" 
              id="email" 
              name="email"
              required
              class="w-full px-4 py-3 rounded-xl border border-hartwood-sand bg-white/50 focus:outline-none focus:ring-2 focus:ring-hartwood-brown/50 focus:border-hartwood-brown transition-all text-hartwood-espresso placeholder-hartwood-taupe"
              placeholder="john@example.com"
            />
          </div>
          
          <div>
            <label for="projectType" class="block text-sm font-medium text-hartwood-espresso mb-2">Project Type</label>
            <select 
              id="projectType" 
              name="projectType"
              required
              class="w-full px-4 py-3 rounded-xl border border-hartwood-sand bg-white/50 focus:outline-none focus:ring-2 focus:ring-hartwood-brown/50 focus:border-hartwood-brown transition-all text-hartwood-espresso"
            >
              <option value="">Select a project type</option>
              <option value="kitchen">Custom Kitchen</option>
              <option value="bathroom">Bathroom Vanity</option>
              <option value="built-in">Built-In Storage</option>
              <option value="commercial">Commercial Millwork</option>
              <option value="furniture">Custom Furniture</option>
              <option value="restoration">Restoration</option>
              <option value="other">Other</option>
            </select>
          </div>
          
          <div>
            <label for="message" class="block text-sm font-medium text-hartwood-espresso mb-2">Tell Us About Your Project</label>
            <textarea 
              id="message" 
              name="message"
              rows="4"
              required
              class="w-full px-4 py-3 rounded-xl border border-hartwood-sand bg-white/50 focus:outline-none focus:ring-2 focus:ring-hartwood-brown/50 focus:border-hartwood-brown transition-all text-hartwood-espresso placeholder-hartwood-taupe resize-none"
              placeholder="Describe your vision, timeline, and any specific requirements..."
            ></textarea>
          </div>
          
          <button 
            type="submit"
            class="w-full py-4 bg-hartwood-espresso text-hartwood-cream font-medium rounded-xl hover:bg-hartwood-walnut transition-colors flex items-center justify-center gap-2"
          >
            <span>Send Inquiry</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>
        
        <div id="form-success" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded-xl text-green-800 text-center">
          <p class="font-medium">Thank you for reaching out!</p>
          <p class="text-sm mt-1">We'll be in touch within 24 hours.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form');
  const successMessage = document.getElementById('form-success');
  
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    // In a real app, this would send data to a server
    // For now, we show the success message
    form.classList.add('hidden');
    successMessage.classList.remove('hidden');
  });
</script>
