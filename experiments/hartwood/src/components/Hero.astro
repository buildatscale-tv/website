---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0">
    <img 
      src="/experiments/hartwood/images/hero-cabinets.jpg" 
      alt="Custom handcrafted cabinets" 
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-hartwood-espresso/70 via-hartwood-espresso/50 to-hartwood-espresso/80"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center pt-20">
    <p class="text-hartwood-gold text-sm font-medium tracking-[0.3em] uppercase mb-6 animate-fade-in-up opacity-0">
      Est. 1987 — Fine Woodworking
    </p>
    <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-semibold text-hartwood-cream mb-8 leading-[1.1] animate-fade-in-up opacity-0 delay-100">
      Crafted with<br />
      <span class="italic font-medium">Precision & Passion</span>
    </h1>
    <p class="text-lg md:text-xl text-hartwood-sand max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-in-up opacity-0 delay-200">
      Bespoke cabinetry and fine woodworking that transforms your space into something extraordinary. 
      Every grain tells a story.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up opacity-0 delay-300">
      <a href="#portfolio" class="inline-flex items-center justify-center px-8 py-4 bg-hartwood-cream text-hartwood-espresso font-medium rounded-full hover:bg-white transition-colors">
        View Our Work
      </a>
      <a href="#contact" class="inline-flex items-center justify-center px-8 py-4 border border-hartwood-cream/30 text-hartwood-cream font-medium rounded-full hover:bg-hartwood-cream/10 transition-colors backdrop-blur-sm">
        Start Your Project
      </a>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-hartwood-cream/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
